@page
@model StructTrace.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    ViewData["AuthAsideTitle"] = "Locked out? It happens.";
    ViewData["AuthAsideText"] = "Enter your email and we will send you a secure link to choose a new password.";
    ViewData["AuthAsideFoot"] = "Reset links work once and expire after 2 hours.";
    ViewData["AuthAsideCompact"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/structtrace-auth.css" asp-append-version="true" />
}

<div class="st-auth">
    <div class="st-auth-card st-auth-card--narrow">

        <partial name="_AuthAside" />

        <section class="st-auth-main" aria-labelledby="forgot-title">
            <h1 id="forgot-title">Forgot your password?</h1>
            <p class="st-auth-lead">
                Type the email address you use for StructTrace. If it has an account, we will email you a link to reset your password.
            </p>

            <form method="post" data-auth-form novalidate>
                <div asp-validation-summary="ModelOnly" class="st-auth-alert st-auth-alert--error" role="alert"></div>

                <div class="st-field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="st-input" autocomplete="email" autofocus placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="st-field-error"></span>
                </div>

                <button type="submit" class="st-auth-submit" data-busy-text="Sending…">Send reset link</button>
                <a class="st-auth-secondary" asp-page="./Login">Back to sign in</a>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/structtrace-auth.js" asp-append-version="true"></script>
}
