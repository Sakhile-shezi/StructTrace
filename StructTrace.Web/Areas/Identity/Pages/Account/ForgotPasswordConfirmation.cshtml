@page
@model StructTrace.Web.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
    ViewData["AuthAsideTitle"] = "Check your inbox";
    ViewData["AuthAsideText"] = "The email comes from StructTrace and contains a button to choose a new password.";
    ViewData["AuthAsideFoot"] = "Reset links work once and expire after 2 hours.";
    ViewData["AuthAsideCompact"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/structtrace-auth.css" asp-append-version="true" />
}

<div class="st-auth">
    <div class="st-auth-card st-auth-card--narrow">

        <partial name="_AuthAside" />

        <section class="st-auth-main" aria-labelledby="sent-title">
            <div class="st-auth-badge st-auth-badge--mail" aria-hidden="true">✉</div>
            <h1 id="sent-title">Check your email</h1>
            <p class="st-auth-lead">
                If
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <strong>@Model.Email</strong>
                }
                else
                {
                    <span>that address</span>
                }
                has a StructTrace account, a password-reset link is on its way.
            </p>

            <ul class="st-auth-tips">
                <li>It usually arrives within a minute.</li>
                <li>Not there? Look in your Spam or Promotions folder.</li>
                <li>The link works once and expires after 2 hours.</li>
            </ul>

            <a class="st-auth-submit" asp-page="./Login" asp-route-email="@Model.Email">Back to sign in</a>
            <a class="st-auth-secondary" asp-page="./ForgotPassword" asp-route-email="@Model.Email">Send the link again</a>
        </section>
    </div>
</div>
