@page
@model StructTrace.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["AuthAsideTitle"] = "Learn algorithms by watching them run";
    ViewData["AuthAsideFoot"] = "Sign in to open DSAVisual, AIVisual and your saved sandbox runs.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/structtrace-auth.css" asp-append-version="true" />
}

<div class="st-auth">
    <div class="st-auth-card">

        <partial name="_AuthAside" />

        <section class="st-auth-main" aria-labelledby="login-title">
            <h1 id="login-title">Welcome back</h1>
            <p class="st-auth-lead">Sign in with your email and password to continue.</p>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="st-auth-alert st-auth-alert--success" role="status">@Model.StatusMessage</div>
            }

            <form id="account" method="post" data-auth-form novalidate>
                <div asp-validation-summary="ModelOnly" class="st-auth-alert st-auth-alert--error" role="alert"></div>

                <div class="st-field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="st-input" autocomplete="username" autofocus
                           placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="st-field-error"></span>
                </div>

                <div class="st-field">
                    <div class="st-field-row">
                        <label asp-for="Input.Password"></label>
                        <a asp-page="./ForgotPassword">Forgot password?</a>
                    </div>
                    <div class="st-password">
                        <input asp-for="Input.Password" class="st-input" autocomplete="current-password" />
                        <button type="button" class="st-password-toggle" data-toggle-password="Input_Password"
                                aria-label="Show password" aria-pressed="false">Show</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="st-field-error"></span>
                </div>

                <label class="st-check">
                    <input asp-for="Input.RememberMe" />
                    <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                </label>

                <button type="submit" class="st-auth-submit" data-busy-text="Signing in…">Sign in</button>
            </form>

            <p class="st-auth-alt">
                New to StructTrace?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/structtrace-auth.js" asp-append-version="true"></script>
}
