@page
@model StructTrace.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create an account";
    ViewData["AuthAsideTitle"] = "Create your free StructTrace account";
    ViewData["AuthAsideText"] = "One account opens every visualizer and keeps your progress and saved traces.";
    ViewData["AuthAsideFoot"] = "We will send a welcome email to the address you register with.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/structtrace-auth.css" asp-append-version="true" />
}

<div class="st-auth">
    <div class="st-auth-card">

        <partial name="_AuthAside" />

        <section class="st-auth-main" aria-labelledby="register-title">
            <h1 id="register-title">Create an account</h1>
            <p class="st-auth-lead">It takes less than a minute.</p>

            <form id="registerForm" method="post" asp-route-returnUrl="@Model.ReturnUrl" data-auth-form novalidate>
                <div asp-validation-summary="ModelOnly" class="st-auth-alert st-auth-alert--error" role="alert"></div>

                <div class="st-field">
                    <label asp-for="Input.FullName"></label>
                    <input asp-for="Input.FullName" class="st-input" autocomplete="name" autofocus
                           placeholder="e.g. Thandi Mokoena" />
                    <span asp-validation-for="Input.FullName" class="st-field-error"></span>
                    <span class="st-field-hint">Shown on your profile and in the admin dashboard.</span>
                </div>

                <div class="st-field">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="st-input" autocomplete="email" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="st-field-error"></span>
                </div>

                <div class="st-field">
                    <label asp-for="Input.Password"></label>
                    <div class="st-password">
                        <input asp-for="Input.Password" class="st-input" autocomplete="new-password" />
                        <button type="button" class="st-password-toggle" data-toggle-password="Input_Password"
                                aria-label="Show password" aria-pressed="false">Show</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="st-field-error"></span>
                    <partial name="_PasswordRules" model="@("Input_Password")" />
                </div>

                <div class="st-field">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <div class="st-password">
                        <input asp-for="Input.ConfirmPassword" class="st-input" autocomplete="new-password" />
                        <button type="button" class="st-password-toggle" data-toggle-password="Input_ConfirmPassword"
                                aria-label="Show password" aria-pressed="false">Show</button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="st-field-error"></span>
                    <span class="st-match" data-match-for="Input_ConfirmPassword" data-match-with="Input_Password" aria-live="polite"></span>
                </div>

                <button type="submit" class="st-auth-submit" data-busy-text="Creating your account…">Create account</button>
            </form>

            <p class="st-auth-alt">
                Already have an account?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
            </p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/structtrace-auth.js" asp-append-version="true"></script>
}
