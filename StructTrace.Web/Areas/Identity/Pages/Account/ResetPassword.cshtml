@page
@model StructTrace.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    ViewData["AuthAsideTitle"] = "Choose a new password";
    ViewData["AuthAsideText"] = "Pick something you have not used before. Your other devices will be signed out.";
    ViewData["AuthAsideFoot"] = "After this you can sign in straight away.";
    ViewData["AuthAsideCompact"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/structtrace-auth.css" asp-append-version="true" />
}

<div class="st-auth">
    <div class="st-auth-card st-auth-card--narrow">

        <partial name="_AuthAside" />

        <section class="st-auth-main" aria-labelledby="reset-title">

            @if (Model.LinkIsBroken)
            {
                <h1 id="reset-title">This link does not work</h1>
                <p class="st-auth-lead">
                    The reset link is incomplete. Open it straight from the email, or ask for a new one.
                </p>
                <a class="st-auth-submit" asp-page="./ForgotPassword">Send a new reset link</a>
                <a class="st-auth-secondary" asp-page="./Login">Back to sign in</a>
            }
            else
            {
                <h1 id="reset-title">Choose a new password</h1>
                <p class="st-auth-lead">Enter the email address of your account and your new password.</p>

                @if (Model.LinkExpired)
                {
                    <div class="st-auth-alert st-auth-alert--error" role="alert">
                        This reset link has expired, has already been used, or belongs to a different email address.
                        <a asp-page="./ForgotPassword" asp-route-email="@Model.Input.Email">Send a new link</a>.
                    </div>
                }

                <form method="post" data-auth-form novalidate>
                    <div asp-validation-summary="ModelOnly" class="st-auth-alert st-auth-alert--error" role="alert"></div>
                    <input asp-for="Input.Code" type="hidden" />

                    <div class="st-field">
                        <label asp-for="Input.Email"></label>
                        <input asp-for="Input.Email" class="st-input" autocomplete="username" autofocus placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="st-field-error"></span>
                    </div>

                    <div class="st-field">
                        <label asp-for="Input.Password"></label>
                        <div class="st-password">
                            <input asp-for="Input.Password" class="st-input" autocomplete="new-password" />
                            <button type="button" class="st-password-toggle" data-toggle-password="Input_Password"
                                    aria-label="Show password" aria-pressed="false">Show</button>
                        </div>
                        <span asp-validation-for="Input.Password" class="st-field-error"></span>
                        <partial name="_PasswordRules" model="@("Input_Password")" />
                    </div>

                    <div class="st-field">
                        <label asp-for="Input.ConfirmPassword"></label>
                        <div class="st-password">
                            <input asp-for="Input.ConfirmPassword" class="st-input" autocomplete="new-password" />
                            <button type="button" class="st-password-toggle" data-toggle-password="Input_ConfirmPassword"
                                    aria-label="Show password" aria-pressed="false">Show</button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="st-field-error"></span>
                        <span class="st-match" data-match-for="Input_ConfirmPassword" data-match-with="Input_Password" aria-live="polite"></span>
                    </div>

                    <button type="submit" class="st-auth-submit" data-busy-text="Saving…">Save new password</button>
                </form>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/structtrace-auth.js" asp-append-version="true"></script>
}
