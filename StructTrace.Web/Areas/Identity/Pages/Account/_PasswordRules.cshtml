@*
    Live checklist of the password rules. The rules are read from the Identity
    options in Program.cs, so the list always matches what the server checks.
    Model = id of the password input, e.g. "Input_Password".
*@
@model string
@using Microsoft.Extensions.Options
@inject IOptions<IdentityOptions> IdentityOptions
@{
    var rules = IdentityOptions.Value.Password;
}

<ul class="st-rules" data-password-rules="@Model" aria-label="Password requirements">
    <li data-rule="length:@rules.RequiredLength">At least @rules.RequiredLength characters</li>
    @if (rules.RequireUppercase)
    {
        <li data-rule="upper">An uppercase letter</li>
    }
    @if (rules.RequireLowercase)
    {
        <li data-rule="lower">A lowercase letter</li>
    }
    @if (rules.RequireDigit)
    {
        <li data-rule="digit">A number</li>
    }
    @if (rules.RequireNonAlphanumeric)
    {
        <li data-rule="symbol">A symbol, e.g. ! @@ # ?</li>
    }
    @if (rules.RequiredUniqueChars > 1)
    {
        <li data-rule="unique:@rules.RequiredUniqueChars">@rules.RequiredUniqueChars different characters</li>
    }
</ul>
