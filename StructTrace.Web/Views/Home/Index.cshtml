@{
    ViewData["Title"] = "Home";

    var dsaVisualizerUrl = Url.Content("~/dsa-visualizer/index.html");
}

<div class="st-home">

    <!-- HERO SECTION -->
    <section class="st-hero">
        <div class="st-hero-grid">

            <div class="st-hero-content">
                <span class="st-eyebrow">
                    <span class="st-status-dot"></span>
                    INTERACTIVE DSA & MULTI-LANGUAGE PLATFORM
                </span>

                <h1>
                    Understand Data Structures.
                    <span>Visualize Algorithms.</span>
                </h1>

                <p class="st-hero-description">
                    Go beyond memorizing code. Explore how data structures work,
                    trace algorithms step by step, understand pointer mutations,
                    and experiment with real implementations in multiple programming languages.
                </p>

                <div class="st-hero-actions">
                    <a href="@dsaVisualizerUrl" class="st-btn st-btn-primary">
                        Explore DSAVisual
                        <span>→</span>
                    </a>

                    <a href="/Sandbox" class="st-btn st-btn-outline">
                        Open Code Sandbox
                    </a>
                </div>

                <div class="st-hero-highlights">
                    <div>
                        <span class="st-highlight-number">09</span>
                        <span class="st-highlight-label">Learning modules</span>
                    </div>

                    <div>
                        <span class="st-highlight-number">04</span>
                        <span class="st-highlight-label">Programming languages</span>
                    </div>

                    <div>
                        <span class="st-highlight-number">∞</span>
                        <span class="st-highlight-label">Learning opportunities</span>
                    </div>
                </div>
            </div>

            <!-- VISUAL WORKFLOW CARD -->
            <div class="st-hero-visual">
                <div class="st-workflow-card">

                    <div class="st-window-header">
                        <div class="st-window-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <span>YOUR LEARNING JOURNEY</span>
                    </div>

                    <div class="st-workflow-heading">
                        <span class="st-workflow-icon">01</span>
                        <div>
                            <h3>Learn visually</h3>
                            <p>Understand the underlying concepts.</p>
                        </div>
                    </div>

                    <div class="st-workflow-connector"></div>

                    <div class="st-workflow-heading">
                        <span class="st-workflow-icon">02</span>
                        <div>
                            <h3>Trace execution</h3>
                            <p>Follow every important algorithm step.</p>
                        </div>
                    </div>

                    <div class="st-workflow-connector"></div>

                    <div class="st-workflow-heading">
                        <span class="st-workflow-icon">03</span>
                        <div>
                            <h3>Write and test code</h3>
                            <p>Apply what you have learned.</p>
                        </div>
                    </div>

                    <div class="st-workflow-footer">
                        <span class="st-live-dot"></span>
                        Learn · Visualize · Implement
                    </div>

                </div>
            </div>

        </div>

        <div class="st-hero-decoration st-decoration-one"></div>
        <div class="st-hero-decoration st-decoration-two"></div>
    </section>


    <!-- PLATFORM FEATURES -->
    <section class="st-section">

        <div class="st-section-heading">
            <span class="st-section-label">EXPLORE THE PLATFORM</span>
            <h2>Everything you need to master DSA</h2>
            <p>
                Learn the concepts, understand the execution process,
                and strengthen your programming skills through practical experience.
            </p>
        </div>

        <div class="st-feature-grid">

            <!-- DSA VISUAL CARD -->
            <article class="st-feature-card st-visual-card">

                <div class="st-card-top">
                    <div class="st-feature-icon st-icon-blue">
                        <span>01</span>
                    </div>

                    <span class="st-card-badge">LEARN & VISUALIZE</span>
                </div>

                <h3>DSAVisual</h3>

                <p>
                    Explore a structured 9-module curriculum designed to help
                    you understand data structures and algorithms visually.
                    Follow operations step by step and study their behaviour.
                </p>

                <div class="st-feature-tags">
                    <span>Big-O Notation</span>
                    <span>Linked Lists</span>
                    <span>Stacks & Queues</span>
                    <span>Heaps</span>
                    <span>BST & AVL Trees</span>
                    <span>Hashing</span>
                    <span>Graphs</span>
                    <span>Algorithms</span>
                </div>

                <div class="st-card-bottom">
                    <a href="@dsaVisualizerUrl" class="st-card-link">
                        Explore curriculum <span>→</span>
                    </a>
                </div>

            </article>


            <!-- SANDBOX CARD -->
            <article class="st-feature-card st-sandbox-card">

                <div class="st-card-top">
                    <div class="st-feature-icon st-icon-cyan">
                        <span>02</span>
                    </div>

                    <span class="st-card-badge">CODE & EXPERIMENT</span>
                </div>

                <h3>Multi-Language Code Sandbox</h3>

                <p>
                    Write and test your implementations in different programming
                    languages. Generate execution traces and explore how your
                    data structures and algorithms behave.
                </p>

                <div class="st-language-list">
                    <div class="st-language">
                        <span class="st-language-symbol">C++</span>
                        <span>C++</span>
                    </div>

                    <div class="st-language">
                        <span class="st-language-symbol">J</span>
                        <span>Java</span>
                    </div>

                    <div class="st-language">
                        <span class="st-language-symbol">Py</span>
                        <span>Python</span>
                    </div>

                    <div class="st-language">
                        <span class="st-language-symbol">C#</span>
                        <span>C#</span>
                    </div>
                </div>

                <div class="st-sandbox-note">
                    <span class="st-live-dot"></span>
                    Step-by-step execution traces and Neon PostgreSQL storage
                </div>

                <div class="st-card-bottom">
                    <a href="/Sandbox" class="st-card-link">
                        Open Code Sandbox <span>→</span>
                    </a>
                </div>

            </article>

        </div>
    </section>


    <!-- TOPICS SECTION -->
    <section class="st-topics-section">

        <div class="st-topics-content">
            <div>
                <span class="st-section-label">YOUR LEARNING TOOLKIT</span>
                <h2>Build a strong foundation in computer science</h2>
                <p>
                    From fundamental complexity analysis to advanced tree
                    structures and graph algorithms, explore the concepts
                    that power efficient software.
                </p>
            </div>

            <div class="st-topics-cloud">
                <span>Big-O Analysis</span>
                <span>Binary Search</span>
                <span>Linked Lists</span>
                <span>Stacks</span>
                <span>Queues</span>
                <span>Heaps</span>
                <span>Binary Search Trees</span>
                <span>AVL Trees</span>
                <span>Hash Tables</span>
                <span>BFS</span>
                <span>Dijkstra's Algorithm</span>
                <span>Sorting Algorithms</span>
            </div>
        </div>

    </section>


    <!-- CONTACT FOOTER -->
    <footer class="st-footer">

        <div class="st-footer-main">

            <div class="st-footer-brand">
                <a href="/" class="st-brand-name">
                    StructTrace<span>.Web</span>
                </a>

                <p>
                    Making Data Structures and Algorithms easier to understand,
                    one visual step at a time.
                </p>

                <span class="st-footer-tagline">
                    Learn. Visualize. Implement.
                </span>
            </div>


            <div class="st-footer-links">
                <h4>Quick Links</h4>

                <a href="/">Home</a>
                <a href="@dsaVisualizerUrl">DSAVisual</a>
                <a href="/Sandbox">Code Sandbox</a>
            </div>


            <div class="st-footer-contact">
