@{
    ViewData["Title"] = "Home";

    var dsaVisualizerUrl = Url.Content("~/dsa-visualizer/index.html?v=6");
    var aiVisualizerUrl = Url.Content("~/ai-visualizer/index.html?v=6");
}

<div class="st-home">

    <!-- =====================================================
         HERO SECTION
         ===================================================== -->

    <section class="st-hero">

        <div class="st-hero-grid">

            <div class="st-hero-content">

                <span class="st-eyebrow">
                    <span class="st-status-dot"></span>
                    INTERACTIVE DSA, AI & MULTI-LANGUAGE PLATFORM
                </span>

                <h1>
                    Understand Data Structures.
                    <span>Explore Artificial Intelligence.</span>
                </h1>

                <p class="st-hero-description">
                    Go beyond memorizing code. Explore data structures and algorithms,
                    understand Artificial Intelligence concepts, trace executions
                    step by step, and experiment with practical implementations
                    in multiple programming languages.
                </p>

                <div class="st-hero-actions">

                    <a href="@dsaVisualizerUrl" class="st-btn st-btn-primary">
                        Explore DSAVisual
                        <span>→</span>
                    </a>

                    <a href="@aiVisualizerUrl" class="st-btn st-btn-outline st-ai-btn">
                        Explore AIVisual
                        <span>→</span>
                    </a>

                    <a href="/Sandbox" class="st-btn st-btn-outline">
                        Open Code Sandbox
                    </a>

                </div>

                <div class="st-hero-highlights">

                    <div>
                        <span class="st-highlight-number">09</span>
                        <span class="st-highlight-label">DSA learning modules</span>
                    </div>

                    <div>
                        <span class="st-highlight-number">02</span>
                        <span class="st-highlight-label">Interactive learning platforms</span>
                    </div>

                    <div>
                        <span class="st-highlight-number">∞</span>
                        <span class="st-highlight-label">Learning opportunities</span>
                    </div>

                </div>

            </div>


            <!-- VISUAL WORKFLOW CARD -->

            <div class="st-hero-visual">

                <div class="st-workflow-card">

                    <div class="st-window-header">

                        <div class="st-window-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                        <span>YOUR LEARNING JOURNEY</span>

                    </div>


                    <div class="st-workflow-heading">

                        <span class="st-workflow-icon">01</span>

                        <div>
                            <h3>Learn visually</h3>
                            <p>Understand the underlying concepts.</p>
                        </div>

                    </div>

                    <div class="st-workflow-connector"></div>


                    <div class="st-workflow-heading">

                        <span class="st-workflow-icon">02</span>

                        <div>
                            <h3>Explore algorithms</h3>
                            <p>Follow how intelligent systems solve problems.</p>
                        </div>

                    </div>

                    <div class="st-workflow-connector"></div>


                    <div class="st-workflow-heading">

                        <span class="st-workflow-icon">03</span>

                        <div>
                            <h3>Write and test code</h3>
                            <p>Apply what you have learned through programming.</p>
                        </div>

                    </div>


                    <div class="st-workflow-footer">

                        <span class="st-live-dot"></span>

                        Learn · Visualize · Implement

                    </div>

                </div>

            </div>

        </div>

        <div class="st-hero-decoration st-decoration-one"></div>
        <div class="st-hero-decoration st-decoration-two"></div>

    </section>


    <!-- =====================================================
         PLATFORM FEATURES
         ===================================================== -->

    <section class="st-section">

        <div class="st-section-heading">

            <span class="st-section-label">EXPLORE THE PLATFORM</span>

            <h2>Everything you need to learn, visualise and build</h2>

            <p>
                Explore Data Structures and Algorithms, study Artificial
                Intelligence, and strengthen your programming skills
                through practical experience.
            </p>

        </div>


        <div class="st-feature-grid">


            <!-- =================================================
                 DSA VISUAL CARD
                 ================================================= -->

            <article class="st-feature-card st-visual-card">

                <div class="st-card-top">

                    <div class="st-feature-icon st-icon-blue">
                        <span>01</span>
                    </div>

                    <span class="st-card-badge">
                        LEARN & VISUALIZE
                    </span>

                </div>

                <h3>DSAVisual</h3>

                <p>
                    Explore a structured 9-module curriculum designed
                    to help you understand Data Structures and Algorithms
                    visually.

                    Follow operations step by step and study their behaviour.
                </p>

                <div class="st-feature-tags">

                    <span>Big-O Notation</span>
                    <span>Linked Lists</span>
                    <span>Stacks & Queues</span>
                    <span>Heaps</span>
                    <span>BST & AVL Trees</span>
                    <span>Hashing</span>
                    <span>Graphs</span>
                    <span>Algorithms</span>

                </div>

                <div class="st-card-bottom">

                    <a href="@dsaVisualizerUrl" class="st-card-link">
                        Explore DSAVisual <span>→</span>
                    </a>

                </div>

            </article>


            <!-- =================================================
                 CODE SANDBOX CARD
                 ================================================= -->

            <article class="st-feature-card st-sandbox-card">

                <div class="st-card-top">

                    <div class="st-feature-icon st-icon-cyan">
                        <span>02</span>
                    </div>

                    <span class="st-card-badge">
                        CODE & EXPERIMENT
                    </span>

                </div>

                <h3>Multi-Language Code Sandbox</h3>

                <p>
                    Write and test your implementations in different
                    programming languages.

                    Generate execution traces and explore how your
                    data structures and algorithms behave.
                </p>

                <div class="st-language-list">

                    <div class="st-language">
                        <span class="st-language-symbol">C++</span>
                        <span>C++</span>
                    </div>

                    <div class="st-language">
                        <span class="st-language-symbol">J</span>
                        <span>Java</span>
                    </div>

                    <div class="st-language">
                        <span class="st-language-symbol">Py</span>
                        <span>Python</span>
                    </div>

                    <div class="st-language">
                        <span class="st-language-symbol">C#</span>
                        <span>C#</span>
                    </div>

                </div>

                <div class="st-sandbox-note">

                    <span class="st-live-dot"></span>

                    Step-by-step execution traces and Neon PostgreSQL storage

                </div>

                <div class="st-card-bottom">

                    <a href="/Sandbox" class="st-card-link">
                        Open Code Sandbox <span>→</span>
                    </a>

                </div>

            </article>


            <!-- =================================================
                 AI VISUAL CARD - NEW
                 ================================================= -->

            <article class="st-feature-card st-ai-visual-card">

                <div class="st-card-top">

                    <div class="st-feature-icon st-icon-purple">
                        <span>03</span>
                    </div>

                    <span class="st-card-badge">
                        ARTIFICIAL INTELLIGENCE
                    </span>

                </div>

                <h3>AIVisual</h3>

                <p>
                    Learn Artificial Intelligence through detailed
                    COMP304 explanations, interactive visualizations,
                    important formulas, worked examples and practical
                    Python programming.
                </p>

                <div class="st-feature-tags">

                    <span>Search Algorithms</span>
                    <span>State Spaces</span>
                    <span>Minimax</span>
                    <span>Alpha-Beta Pruning</span>
                    <span>Genetic Algorithms</span>
                    <span>Machine Learning</span>
                    <span>Perceptrons</span>
                    <span>Predicate Logic</span>
                    <span>Python</span>

                </div>

                <div class="st-card-bottom">

                    <a href="@aiVisualizerUrl" class="st-card-link">
                        Explore AIVisual <span>→</span>
                    </a>

                </div>

            </article>


        </div>

    </section>


