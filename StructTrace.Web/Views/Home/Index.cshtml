                <a href="mailto:shezi9835@gmail.com">
                    <span class="st-contact-icon">✉</span>
                    <span>shezi9835@gmail.com</span>
                </a>

                <a href="mailto:224064919@stu.ukzn.ac.za">
                    <span class="st-contact-icon">✉</span>
                    <span>224064919@stu.ukzn.ac.za</span>
                </a>

                <a href="https://github.com/Sakhile-shezi"
                   target="_blank"
                   rel="noopener noreferrer">
                    <span class="st-contact-icon">⌘</span>
                    <span>GitHub</span>
