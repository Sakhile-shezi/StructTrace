        function parseInts(raw) {
            return raw.split(",")
                .map(s => parseInt(s.trim(), 10))
                .filter(n => !Number.isNaN(n))
                .slice(0, 15);
        }

        function cloneBst(node) {
            if (!node) return null;
            return { key: node.key, left: cloneBst(node.left), right: cloneBst(node.right) };
        }

        function buildFrames(topic, rawInput) {
            if (topic === "BST") {
                const nums = parseInts(rawInput);
                if (!nums.length) return [{ type: "BST", root: null, active: null, comparing: [], caption: "Enter at least one integer." }];
                const list = [];
                let root = null;
                for (const val of nums) {
                    if (!root) {
                        root = { key: val, left: null, right: null };
                        list.push({ type: "BST", root: cloneBst(root), active: val, comparing: [], caption: `Inserted ${val} as root node.` });
                        continue;
                    }
                    let curr = root;
                    const path = [];
                    while (curr) {
                        path.push(curr.key);
                        if (val === curr.key) {
                            list.push({ type: "BST", root: cloneBst(root), active: curr.key, comparing: [...path], caption: `Duplicate key ${val} ignored.` });
                            break;
                        } else if (val < curr.key) {
                            if (!curr.left) {
                                curr.left = { key: val, left: null, right: null };
                                list.push({ type: "BST", root: cloneBst(root), active: val, comparing: [...path], caption: `${val} < ${curr.key}: inserted ${val} as left child of ${curr.key}.` });
                                break;
                            }
                            curr = curr.left;
                        } else {
                            if (!curr.right) {
                                curr.right = { key: val, left: null, right: null };
                                list.push({ type: "BST", root: cloneBst(root), active: val, comparing: [...path], caption: `${val} > ${curr.key}: inserted ${val} as right child of ${curr.key}.` });
                                break;
                            }
                            curr = curr.right;
                        }
                    }
                }
                return list;
            }

            if (topic === "LinkedList") {
                const nums = parseInts(rawInput);
                if (!nums.length) return [{ type: "LinkedList", items: [], activeIdx: -1, caption: "Empty list." }];
                const list = [], items = [];
                nums.forEach((v, i) => {
                    items.push(v);
                    list.push({
                        type: "LinkedList",
                        items: [...items],
                        activeIdx: i,
                        caption: i === 0 ? `Created HEAD node with value ${v}.` : `Linked tail.next -> ${v} and updated TAIL.`
                    });
                });
                return list;
            }

            if (topic === "DoublyLinkedList") {
                const nums = parseInts(rawInput);
                if (!nums.length) return [{ type: "DoublyLinkedList", items: [], activeIdx: -1, caption: "Empty doubly linked list." }];
                const list = [], items = [];
                nums.forEach((v, i) => {
                    items.push(v);
                    list.push({
                        type: "DoublyLinkedList",
                        items: [...items],
                        activeIdx: i,
                        caption: i === 0
                            ? `Created HEAD node ${v} with prev = null, next = null.`
                            : `Linked ${items[i - 1]}.next -> ${v} and ${v}.prev -> ${items[i - 1]}.`
                    });
                });
                return list;
            }

            if (topic === "Stack") {
                const tokens = rawInput.split(",").map(s => s.trim()).filter(Boolean);
                const list = [], stack = [];
                for (const tok of tokens) {
                    if (tok.toLowerCase().startsWith("pop")) {
                        if (!stack.length) {
                            list.push({ type: "Stack", items: [], activeIdx: -1, caption: "Stack Underflow: stack is empty." });
                        } else {
                            const popped = stack.pop();
                            list.push({ type: "Stack", items: [...stack], activeIdx: stack.length - 1, caption: `Popped ${popped} from TOP.` });
                        }
                    } else {
                        const num = parseInt(tok.replace(/[^0-9-]/g, ""), 10);
                        if (!Number.isNaN(num)) {
                            stack.push(num);
                            list.push({ type: "Stack", items: [...stack], activeIdx: stack.length - 1, caption: `Pushed ${num} onto TOP.` });
                        }
                    }
                }
                return list.length ? list : [{ type: "Stack", items: [], activeIdx: -1, caption: "No stack operations parsed." }];
            }

            if (topic === "Queue") {
                const tokens = rawInput.split(",").map(s => s.trim()).filter(Boolean);
                const list = [], q = [];
                for (const tok of tokens) {
                    if (tok.toLowerCase().startsWith("dequeue") || tok.toLowerCase().startsWith("pop")) {
                        if (!q.length) {
                            list.push({ type: "Queue", items: [], activeIdx: -1, caption: "Queue Underflow: queue is empty." });
                        } else {
                            const dequeued = q.shift();
                            list.push({ type: "Queue", items: [...q], activeIdx: 0, caption: `Dequeued ${dequeued} from FRONT.` });
                        }
                    } else {
                        const num = parseInt(tok.replace(/[^0-9-]/g, ""), 10);
                        if (!Number.isNaN(num)) {
                            q.push(num);
                            list.push({ type: "Queue", items: [...q], activeIdx: q.length - 1, caption: `Enqueued ${num} at REAR.` });
                        }
                    }
                }
                return list.length ? list : [{ type: "Queue", items: [], activeIdx: -1, caption: "No queue operations parsed." }];
            }

            if (topic === "MinHeap") {
                const nums = parseInts(rawInput);
                if (!nums.length) return [{ type: "MinHeap", heap: [], activeIdx: -1, swapIdx: -1, caption: "Empty heap." }];
                const list = [], heap = [];
                for (const val of nums) {
                    heap.push(val);
                    let i = heap.length - 1;
                    list.push({ type: "MinHeap", heap: [...heap], activeIdx: i, swapIdx: -1, caption: `Inserted ${val} at index ${i}.` });
                    while (i > 0) {
                        const p = Math.floor((i - 1) / 2);
                        if (heap[i] < heap[p]) {
                            [heap[i], heap[p]] = [heap[p], heap[i]];
                            list.push({ type: "MinHeap", heap: [...heap], activeIdx: p, swapIdx: i, caption: `SiftUp: swapped ${heap[p]} with parent ${heap[i]}.` });
                            i = p;
                        } else break;
                    }
                }
                return list;
            }

            if (topic === "HashTable") {
                const nums = parseInts(rawInput);
                const mMatch = (testArgInput.value || "").match(/buckets\s*=\s*(\d+)/i);
                const bucketsCount = Math.min(Math.max(parseInt(mMatch?.[1] || "7", 10) || 7, 3), 10);
                const buckets = Array.from({ length: bucketsCount }, () => []);
                const list = [{ type: "HashTable", buckets: buckets.map(b => [...b]), activeBucket: -1, caption: `Initialized ${bucketsCount} buckets.` }];

                for (const val of nums) {
                    const idx = ((val % bucketsCount) + bucketsCount) % bucketsCount;
                    buckets[idx].push(val);
                    list.push({
                        type: "HashTable",
                        buckets: buckets.map(b => [...b]),
                        activeBucket: idx,
                        caption: `Key ${val} -> bucket ${idx} (${val} mod ${bucketsCount} = ${idx}).`
                    });
                }
                return list;
            }

            if (topic === "BFS" || topic === "DFS") {
                const edges = [], adj = {};
                rawInput.split(",").map(s => s.trim()).filter(Boolean).forEach(pair => {
                    const [u, v] = pair.split("-").map(x => x.trim().toUpperCase());
                    if (u && v) {
                        edges.push([u, v]);
                        adj[u] = adj[u] || []; adj[v] = adj[v] || [];
                        if (!adj[u].includes(v)) adj[u].push(v);
                        if (!adj[v].includes(u)) adj[v].push(u);
                    }
                });
                const nodes = Object.keys(adj).sort();
                if (!nodes.length) return [{ type: "Graph", nodes: [], edges: [], visited: [], frontier: [], active: null, caption: "Enter edges like A-B, A-C." }];
                nodes.forEach(n => adj[n].sort());

                const startMatch = (testArgInput.value || "").match(/start\s*=\s*([A-Za-z0-9]+)/i);
                const start = (startMatch && adj[startMatch[1].toUpperCase()]) ? startMatch[1].toUpperCase() : nodes[0];

                const list = [];
                if (topic === "BFS") {
                    const visited = new Set([start]), settled = [], q = [start];
                    list.push({ type: "Graph", nodes, edges, visited: [], frontier: [...q], active: null, caption: `Enqueued start vertex ${start}.` });
                    while (q.length) {
                        const u = q.shift();
                        settled.push(u);
                        list.push({ type: "Graph", nodes, edges, visited: [...settled], frontier: [...q], active: u, caption: `BFS dequeued ${u} -> Visited: [${settled.join(", ")}].` });
                        for (const v of adj[u]) {
                            if (!visited.has(v)) {
                                visited.add(v); q.push(v);
                                list.push({ type: "Graph", nodes, edges, visited: [...settled], frontier: [...q], active: u, caption: `Enqueued ${v} from ${u}.` });
                            }
                        }
                    }
                } else {
                    const visited = new Set(), settled = [], stack = [start];
                    list.push({ type: "Graph", nodes, edges, visited: [], frontier: [...stack], active: null, caption: `Pushed start vertex ${start} onto DFS stack.` });
                    while (stack.length) {
                        const u = stack.pop();
                        if (visited.has(u)) continue;
                        visited.add(u); settled.push(u);
                        list.push({ type: "Graph", nodes, edges, visited: [...settled], frontier: [...stack], active: u, caption: `DFS popped ${u} -> Visited: [${settled.join(", ")}].` });
                        for (const v of [...adj[u]].reverse()) {
                            if (!visited.has(v)) {
                                stack.push(v);
                                list.push({ type: "Graph", nodes, edges, visited: [...settled], frontier: [...stack], active: u, caption: `Pushed ${v} onto DFS stack from ${u}.` });
                            }
                        }
                    }
                }
                return list;
            }

            if (topic === "Dijkstra") {
                const edges = [], adj = {};
                rawInput.split(",").map(s => s.trim()).filter(Boolean).forEach(item => {
                    const [pair, wStr] = item.split(":");
                    const [u, v] = (pair || "").split("-").map(x => x.trim().toUpperCase());
                    const w = parseInt((wStr || "1").trim(), 10) || 1;
                    if (u && v) {
                        edges.push([u, v, w]);
                        adj[u] = adj[u] || []; adj[v] = adj[v] || [];
                        adj[u].push({ to: v, w });
                    }
                });
                const nodes = Object.keys(adj).sort();
                if (!nodes.length) return [{ type: "Graph", nodes: [], edges: [], visited: [], frontier: [], active: null, caption: "Enter weighted edges like A-B:4, A-C:2." }];

                const startMatch = (testArgInput.value || "").match(/start\s*=\s*([A-Za-z0-9]+)/i);
                const start = (startMatch && adj[startMatch[1].toUpperCase()]) ? startMatch[1].toUpperCase() : nodes[0];

                const dist = {};
                nodes.forEach(n => dist[n] = Infinity);
                dist[start] = 0;
                const settled = [], pq = [{ node: start, d: 0 }];
                const list = [{ type: "Graph", nodes, edges, dist: { ...dist }, visited: [], frontier: [start], active: start, caption: `Initialized dist[${start}] = 0.` }];

                while (pq.length) {
                    pq.sort((a, b) => a.d - b.d);
                    const { node: u, d } = pq.shift();
                    if (d > dist[u]) continue;
                    if (!settled.includes(u)) settled.push(u);
                    list.push({ type: "Graph", nodes, edges, dist: { ...dist }, visited: [...settled], frontier: pq.map(x => x.node), active: u, caption: `Settled ${u} with distance ${d}.` });
                    for (const { to: v, w } of adj[u]) {
                        if (dist[u] + w < dist[v]) {
                            dist[v] = dist[u] + w;
                            pq.push({ node: v, d: dist[v] });
                            list.push({ type: "Graph", nodes, edges, dist: { ...dist }, visited: [...settled], frontier: pq.map(x => x.node), active: u, caption: `Relaxed ${u}->${v} (w=${w}): dist[${v}] = ${dist[v]}.` });
                        }
                    }
                }
                return list;
            }

            return [];
        }

        function renderFrame(frame) {
            const w = 540, h = 275;
            const dpr = window.devicePixelRatio || 1;
            canvas.width = w * dpr;
            canvas.height = h * dpr;
            canvas.style.width = `${w}px`;
            canvas.style.height = `${h}px`;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.clearRect(0, 0, w, h);

            if (!frame) return;

            if (frame.type === "BST" && frame.root) {
                function drawTree(node, x, y, dx) {
                    if (!node) return;
                    if (node.left) {
                        ctx.strokeStyle = "#94a3b8"; ctx.lineWidth = 2;
                        ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x - dx, y + 58); ctx.stroke();
                        drawTree(node.left, x - dx, y + 58, Math.max(dx * 0.52, 24));
                    }
                    if (node.right) {
                        ctx.strokeStyle = "#94a3b8"; ctx.lineWidth = 2;
                        ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + dx, y + 58); ctx.stroke();
                        drawTree(node.right, x + dx, y + 58, Math.max(dx * 0.52, 24));
                    }
                    const isActive = frame.active === node.key;
                    const isComp = (frame.comparing || []).includes(node.key);
                    ctx.fillStyle = isActive ? "#2563eb" : isComp ? "#fef3c7" : "#dcfce7";
                    ctx.strokeStyle = isActive ? "#1d4ed8" : isComp ? "#d97706" : "#16a34a";
                    ctx.lineWidth = 2.5;
                    ctx.beginPath(); ctx.arc(x, y, 18, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

                    ctx.fillStyle = isActive ? "#ffffff" : "#0f172a";
                    ctx.font = "bold 12px Consolas, monospace";
                    ctx.textAlign = "center"; ctx.textBaseline = "middle";
                    ctx.fillText(String(node.key), x, y);
                }
                drawTree(frame.root, w / 2, 42, 120);
            } else if (frame.type === "LinkedList" || frame.type === "DoublyLinkedList") {
                const isDoubly = frame.type === "DoublyLinkedList";
                const startX = 24, y = 120, boxW = 66, boxH = 40, gap = 24;
                frame.items.forEach((val, i) => {
                    const x = startX + i * (boxW + gap);
                    if (x + boxW > w - 30) return;
                    const active = i === frame.activeIdx;
                    ctx.fillStyle = active ? "#eff6ff" : "#ffffff";
                    ctx.strokeStyle = active ? "#2563eb" : "#475569";
                    ctx.lineWidth = 2;
                    ctx.fillRect(x, y, boxW, boxH); ctx.strokeRect(x, y, boxW, boxH);

                    ctx.fillStyle = "#0f172a";
                    ctx.font = "bold 13px Consolas, monospace";
                    ctx.textAlign = "center"; ctx.textBaseline = "middle";
                    ctx.fillText(String(val), x + boxW / 2, y + boxH / 2);

                    if (i === 0) {
                        ctx.fillStyle = "#2563eb"; ctx.font = "bold 10px sans-serif";
                        ctx.fillText("HEAD", x + boxW / 2, y - 11);
                    }
                    if (i === frame.items.length - 1) {
                        ctx.fillStyle = "#16a34a"; ctx.font = "bold 10px sans-serif";
                        ctx.fillText("TAIL", x + boxW / 2, y + boxH + 14);
                    }

                    if (i < frame.items.length - 1) {
                        ctx.strokeStyle = "#475569"; ctx.lineWidth = 1.8;
                        ctx.beginPath(); ctx.moveTo(x + boxW, y + boxH / 2 - (isDoubly ? 4 : 0));
                        ctx.lineTo(x + boxW + gap - 4, y + boxH / 2 - (isDoubly ? 4 : 0)); ctx.stroke();

                        if (isDoubly) {
                            ctx.strokeStyle = "#2563eb";
                            ctx.beginPath(); ctx.moveTo(x + boxW + gap - 4, y + boxH / 2 + 5);
                            ctx.lineTo(x + boxW + 2, y + boxH / 2 + 5); ctx.stroke();
                        }
                    }
                });
            } else if (frame.type === "Stack") {
                const boxW = 140, boxH = 34, baseX = (w - boxW) / 2, baseY = 230;
                ctx.strokeStyle = "#334155"; ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(baseX - 8, 35); ctx.lineTo(baseX - 8, baseY + 6);
                ctx.lineTo(baseX + boxW + 8, baseY + 6); ctx.lineTo(baseX + boxW + 8, 35);
                ctx.stroke();

                frame.items.forEach((val, idx) => {
                    const y = baseY - (idx + 1) * (boxH + 5);
                    const isTop = idx === frame.items.length - 1;
                    ctx.fillStyle = isTop ? "#2563eb" : "#dcfce7";
                    ctx.strokeStyle = isTop ? "#1d4ed8" : "#16a34a";
                    ctx.lineWidth = 2;
                    ctx.fillRect(baseX, y, boxW, boxH); ctx.strokeRect(baseX, y, boxW, boxH);

                    ctx.fillStyle = isTop ? "#ffffff" : "#0f172a";
                    ctx.font = "bold 13px Consolas, monospace";
                    ctx.textAlign = "center"; ctx.textBaseline = "middle";
                    ctx.fillText(isTop ? `${val}  TOP` : String(val), baseX + boxW / 2, y + boxH / 2);
                });
            } else if (frame.type === "Queue") {
                const startX = 28, y = 115, boxW = 64, boxH = 42, gap = 12;
                frame.items.forEach((val, i) => {
                    const x = startX + i * (boxW + gap);
                    if (x + boxW > w - 24) return;
                    const isFront = i === 0;
                    ctx.fillStyle = isFront ? "#dbeafe" : "#dcfce7";
                    ctx.strokeStyle = isFront ? "#2563eb" : "#16a34a";
                    ctx.lineWidth = 2;
                    ctx.fillRect(x, y, boxW, boxH); ctx.strokeRect(x, y, boxW, boxH);

                    ctx.fillStyle = "#0f172a";
                    ctx.font = "bold 13px Consolas, monospace";
                    ctx.textAlign = "center"; ctx.textBaseline = "middle";
                    ctx.fillText(String(val), x + boxW / 2, y + boxH / 2);

                    if (i === 0) {
                        ctx.fillStyle = "#2563eb"; ctx.font = "bold 10px sans-serif";
                        ctx.fillText("FRONT", x + boxW / 2, y - 11);
                    }
                    if (i === frame.items.length - 1) {
                        ctx.fillStyle = "#16a34a"; ctx.font = "bold 10px sans-serif";
                        ctx.fillText("REAR", x + boxW / 2, y + boxH + 14);
                    }
                });
            } else if (frame.type === "MinHeap") {
                const arr = frame.heap || [], coords = [];
                arr.forEach((_, i) => {
                    const level = Math.floor(Math.log2(i + 1));
                    const posInLevel = i - (Math.pow(2, level) - 1);
                    const slots = Math.pow(2, level);
                    coords[i] = { x: (w / (slots + 1)) * (posInLevel + 1), y: 34 + level * 56 };
                });
                arr.forEach((_, i) => {
                    if (i === 0) return;
                    const p = Math.floor((i - 1) / 2);
                    ctx.strokeStyle = "#94a3b8"; ctx.lineWidth = 2;
                    ctx.beginPath(); ctx.moveTo(coords[p].x, coords[p].y); ctx.lineTo(coords[i].x, coords[i].y); ctx.stroke();
                });
                arr.forEach((val, i) => {
                    const isAct = i === frame.activeIdx, isSwap = i === frame.swapIdx;
                    ctx.fillStyle = isAct ? "#2563eb" : isSwap ? "#fef3c7" : "#dcfce7";
                    ctx.strokeStyle = isAct ? "#1d4ed8" : isSwap ? "#d97706" : "#16a34a";
                    ctx.lineWidth = 2.2;
                    ctx.beginPath(); ctx.arc(coords[i].x, coords[i].y, 17, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

                    ctx.fillStyle = isAct ? "#ffffff" : "#0f172a";
                    ctx.font = "bold 12px Consolas, monospace";
                    ctx.textAlign = "center"; ctx.textBaseline = "middle";
                    ctx.fillText(String(val), coords[i].x, coords[i].y);
                });
            } else if (frame.type === "HashTable") {
                const buckets = frame.buckets || [];
                const rowH = Math.min(34, Math.floor(235 / Math.max(buckets.length, 1)));
                buckets.forEach((chain, idx) => {
                    const y = 20 + idx * (rowH + 4);
                    const active = idx === frame.activeBucket;
                    ctx.fillStyle = active ? "#2563eb" : "#1e293b";
                    ctx.fillRect(24, y, 54, rowH - 4);
                    ctx.fillStyle = "#ffffff";
                    ctx.font = "bold 11px Consolas, monospace";
                    ctx.textAlign = "center"; ctx.textBaseline = "middle";
                    ctx.fillText(`[${idx}]`, 51, y + (rowH - 4) / 2);

                    chain.forEach((item, cIdx) => {
                        const bx = 92 + cIdx * 56;
                        if (bx + 46 > w - 16) return;
                        ctx.fillStyle = active && cIdx === chain.length - 1 ? "#dbeafe" : "#ffffff";
                        ctx.strokeStyle = active ? "#2563eb" : "#64748b";
                        ctx.lineWidth = 1.5;
                        ctx.fillRect(bx, y, 46, rowH - 4); ctx.strokeRect(bx, y, 46, rowH - 4);
                        ctx.fillStyle = "#0f172a";
                        ctx.fillText(String(item), bx + 23, y + (rowH - 4) / 2);
                    });
                });
            } else if (frame.type === "Graph") {
                const nodes = frame.nodes || [], pos = {};
                const cx = w / 2, cy = 138, rx = 195, ry = 92;
                nodes.forEach((n, i) => {
                    const angle = Math.PI + (i / Math.max(nodes.length, 1)) * Math.PI * 2;
                    pos[n] = { x: cx + rx * Math.cos(angle), y: cy + ry * Math.sin(angle) };
                });

                (frame.edges || []).forEach(([u, v, weight]) => {
                    if (!pos[u] || !pos[v]) return;
                    ctx.strokeStyle = "#94a3b8"; ctx.lineWidth = 2;
                    ctx.beginPath(); ctx.moveTo(pos[u].x, pos[u].y); ctx.lineTo(pos[v].x, pos[v].y); ctx.stroke();
                    if (weight !== undefined) {
                        const mx = (pos[u].x + pos[v].x) / 2, my = (pos[u].y + pos[v].y) / 2;
                        ctx.fillStyle = "#ffffff"; ctx.fillRect(mx - 10, my - 8, 20, 16);
                        ctx.fillStyle = "#1e293b"; ctx.font = "bold 11px Consolas, monospace";
                        ctx.textAlign = "center"; ctx.textBaseline = "middle";
                        ctx.fillText(String(weight), mx, my);
                    }
                });

                nodes.forEach(n => {
                    const isAct = frame.active === n;
                    const isVis = (frame.visited || []).includes(n);
                    const isFront = (frame.frontier || []).includes(n);
                    ctx.fillStyle = isAct ? "#2563eb" : isVis ? "#dcfce7" : isFront ? "#fef3c7" : "#ffffff";
                    ctx.strokeStyle = isAct ? "#1d4ed8" : isVis ? "#16a34a" : isFront ? "#d97706" : "#475569";
                    ctx.lineWidth = 2.5;
                    ctx.beginPath(); ctx.arc(pos[n].x, pos[n].y, 20, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

                    ctx.fillStyle = isAct ? "#ffffff" : "#0f172a";
                    ctx.font = "bold 13px Consolas, monospace";
                    ctx.textAlign = "center"; ctx.textBaseline = "middle";
                    const dVal = frame.dist ? (frame.dist[n] === Infinity ? "∞" : frame.dist[n]) : null;
                    ctx.fillText(dVal !== null ? `${n}:${dVal}` : n, pos[n].x, pos[n].y);
                });
            }
        }

        function updatePlaybackUI() {
            const total = Math.max(frames.length, 1);
            const current = frames[frameIndex];
            stepBadge.textContent = `Step ${frameIndex + 1} / ${total}`;
            stepCaption.textContent = current ? current.caption : "Ready.";
            renderFrame(current);
        }

        function stopAutoPlay() {
            if (playTimer) {
                clearInterval(playTimer);
                playTimer = null;
                playBtn.textContent = "Play";
            }
        }

        function regenerateTrace() {
            stopAutoPlay();
            frames = buildFrames(currentTopic, traceInputEl.value);
            frameIndex = 0;
            updatePlaybackUI();
        }

        function selectTopic(topicKey, preserveEditor = false) {
            if (!TOPICS[topicKey]) return;
            currentTopic = topicKey;
            const cfg = TOPICS[topicKey];

            topicBtns.forEach(b => b.classList.toggle("active", b.dataset.topic === topicKey));
            titleEl.textContent = cfg.title;
            descEl.textContent = cfg.desc;
            badgeEl.textContent = cfg.badge;
            timeEl.textContent = cfg.time;
            spaceEl.textContent = cfg.space;
            traceLabelEl.textContent = cfg.inputLabel;
            traceInputEl.value = cfg.defaultInput;
            testArgInput.value = cfg.defaultArg;

            if (!preserveEditor) {
                codeEditor.value = cfg.templates[currentLang] || "";
            }
            regenerateTrace();
        }

        topicBtns.forEach(btn => btn.addEventListener("click", () => selectTopic(btn.dataset.topic)));

        document.getElementById("sb-preset-balanced").addEventListener("click", () => {
            traceInputEl.value = TOPICS[currentTopic].defaultInput;
            regenerateTrace();
        });
        document.getElementById("sb-preset-edge").addEventListener("click", () => {
            traceInputEl.value = TOPICS[currentTopic].edgeInput;
            regenerateTrace();
        });
        document.getElementById("sb-preset-random").addEventListener("click", () => {
            if (["BST", "LinkedList", "DoublyLinkedList", "MinHeap", "HashTable"].includes(currentTopic)) {
                const set = new Set();
                while (set.size < 6) set.add(Math.floor(Math.random() * 89) + 10);
                traceInputEl.value = Array.from(set).join(", ");
            } else if (currentTopic === "Stack") {
                const a = Math.floor(Math.random() * 50) + 10, b = Math.floor(Math.random() * 50) + 10;
                traceInputEl.value = `push ${a}, push ${b}, pop, push ${a + 5}`;
            } else if (currentTopic === "Queue") {
                const a = Math.floor(Math.random() * 50) + 10, b = Math.floor(Math.random() * 50) + 10;
                traceInputEl.value = `enqueue ${a}, enqueue ${b}, dequeue, enqueue ${b + 5}`;
            }
            regenerateTrace();
        });

        generateBtn.addEventListener("click", regenerateTrace);

        firstBtn.addEventListener("click", () => { stopAutoPlay(); frameIndex = 0; updatePlaybackUI(); });
        prevBtn.addEventListener("click", () => { stopAutoPlay(); if (frameIndex > 0) { frameIndex--; updatePlaybackUI(); } });
        nextBtn.addEventListener("click", () => { stopAutoPlay(); if (frameIndex < frames.length - 1) { frameIndex++; updatePlaybackUI(); } });
        lastBtn.addEventListener("click", () => { stopAutoPlay(); frameIndex = Math.max(frames.length - 1, 0); updatePlaybackUI(); });

        playBtn.addEventListener("click", () => {
            if (playTimer) { stopAutoPlay(); return; }
            if (frameIndex >= frames.length - 1) frameIndex = 0;
            playBtn.textContent = "Pause";
            playTimer = setInterval(() => {
                if (frameIndex < frames.length - 1) { frameIndex++; updatePlaybackUI(); }
                else stopAutoPlay();
            }, parseInt(speedSelect.value, 10) || 550);
        });

        document.addEventListener("keydown", (e) => {
            const tag = (document.activeElement?.tagName || "").toUpperCase();
            if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
            if (e.key === "ArrowLeft" && frameIndex > 0) { stopAutoPlay(); frameIndex--; updatePlaybackUI(); }
            else if (e.key === "ArrowRight" && frameIndex < frames.length - 1) { stopAutoPlay(); frameIndex++; updatePlaybackUI(); }
        });

        langSelect.addEventListener("change", () => {
            currentLang = langSelect.value;
            editorMeta.textContent = LANG_META[currentLang] || "";
            codeEditor.value = TOPICS[currentTopic].templates[currentLang] || "";
        });

        codeEditor.addEventListener("keydown", (e) => {
            if (e.key === "Tab") {
                e.preventDefault();
                const start = codeEditor.selectionStart, end = codeEditor.selectionEnd;
                codeEditor.value = codeEditor.value.substring(0, start) + "    " + codeEditor.value.substring(end);
                codeEditor.selectionStart = codeEditor.selectionEnd = start + 4;
            }
        });

        copyCodeBtn.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(codeEditor.value);
                copyCodeBtn.textContent = "Copied!";
                setTimeout(() => copyCodeBtn.textContent = "Copy", 1400);
            } catch { copyCodeBtn.textContent = "Failed"; }
        });

        resetCodeBtn.addEventListener("click", () => {
            codeEditor.value = TOPICS[currentTopic].templates[currentLang] || "";
        });

        function runSimulation() {
            regenerateTrace();
            const summaryLines = frames.map((f, idx) => `[Step ${idx + 1}] ${f.caption}`);
            const arg = testArgInput.value.trim();
            const header = `=== ${TOPICS[currentTopic].title} | ${currentLang.toUpperCase()} | Arg: ${arg || "none"} ===`;
            const result = `${header}\n${summaryLines.join("\n")}\n\nCompleted ${frames.length} trace frames.`;
            consoleOutput.textContent = result;
            return result;
        }

        simulateBtn.addEventListener("click", runSimulation);

        saveNeonBtn.addEventListener("click", async () => {
            const outputSummary = frames.length ? frames[frames.length - 1].caption : runSimulation().split("\n")[1] || "Executed trace";
            const tokenInput = document.querySelector("#sb-antiforgery-form input[name='__RequestVerificationToken']");
            const antiForgeryToken = tokenInput ? tokenInput.value : "";

            const payload = {
                topic: currentTopic,
                language: currentLang,
                input: traceInputEl.value.trim(),
                output: outputSummary,
                code: codeEditor.value
            };

            saveNeonBtn.disabled = true;
            neonFeedback.className = "small mt-2 fw-semibold text-primary";
            neonFeedback.textContent = "Saving execution trace to Neon PostgreSQL...";

            try {
                const response = await fetch("/Sandbox/Save", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": antiForgeryToken
                    },
                    body: JSON.stringify(payload)
                });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json().catch(() => ({}));
                appendRunRow({
                    id: data.id || data.Id || "",
                    topic: payload.topic,
                    language: payload.language,
                    input: payload.input,
                    output: payload.output,
                    code: payload.code,
                    createdAt: data.createdAt || data.CreatedAt || new Date().toLocaleString()
                });
                neonFeedback.className = "small mt-2 fw-semibold text-success";
                neonFeedback.textContent = "Saved to Neon PostgreSQL.";
            } catch (err) {
                neonFeedback.className = "small mt-2 fw-semibold text-danger";
                neonFeedback.textContent = `Could not persist to /Sandbox/Save: ${err.message}.`;
            } finally {
                saveNeonBtn.disabled = false;
            }
        });

        function appendRunRow(run) {
            const emptyRow = document.getElementById("sb-empty-runs-row");
            if (emptyRow) emptyRow.remove();

            const tbody = document.getElementById("sb-runs-tbody");
            const tr = document.createElement("tr");
            tr.dataset.runId = run.id || "";
            tr.dataset.topic = run.topic;
            tr.dataset.language = run.language;
            tr.dataset.input = run.input;
            tr.dataset.code = run.code;

            tr.innerHTML = `
                <td class="fw-semibold"></td>
                <td><span class="badge bg-dark text-uppercase"></span></td>
                <td class="font-monospace small"></td>
                <td class="small text-muted" style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"></td>
                <td class="small text-muted"></td>
                <td class="text-end">
                    <button type="button" class="btn btn-outline-primary btn-sm sb-load-run-btn">Load</button>
                    ${run.id ? `<button type="button" class="btn btn-outline-danger btn-sm sb-delete-run-btn" data-id="${run.id}">Delete</button>` : ""}
                </td>
            `;
            tr.children[0].textContent = run.topic;
            tr.children[1].querySelector("span").textContent = run.language;
            tr.children[2].textContent = run.input;
            tr.children[3].textContent = run.output;
            tr.children[3].title = run.output;
            tr.children[4].textContent = run.createdAt;

            tbody.prepend(tr);
            document.getElementById("sb-run-count-badge").textContent = String(tbody.querySelectorAll("tr").length);
        }

        document.getElementById("sb-runs-tbody").addEventListener("click", async (e) => {
            const loadBtn = e.target.closest(".sb-load-run-btn");
            if (loadBtn) {
                const tr = loadBtn.closest("tr");
                const topic = tr.dataset.topic || "BST";
                const lang = (tr.dataset.language || "cpp").toLowerCase();
                selectTopic(TOPICS[topic] ? topic : "BST", true);

                if (LANG_META[lang]) {
                    currentLang = lang;
                    langSelect.value = lang;
                    editorMeta.textContent = LANG_META[lang];
                }
                if (tr.dataset.input) {
                    traceInputEl.value = tr.dataset.input;
                    regenerateTrace();
                }
                if (tr.dataset.code) {
                    codeEditor.value = tr.dataset.code;
                }
                neonFeedback.className = "small mt-2 fw-semibold text-primary";
                neonFeedback.textContent = `Loaded saved ${topic} run into workbench.`;
                window.scrollTo({ top: 0, behavior: "smooth" });
                return;
            }

            const delBtn = e.target.closest(".sb-delete-run-btn");
            if (delBtn) {
                const id = delBtn.dataset.id;
                const tr = delBtn.closest("tr");
                const tokenInput = document.querySelector("#sb-antiforgery-form input[name='__RequestVerificationToken']");
                const antiForgeryToken = tokenInput ? tokenInput.value : "";

                try {
                    const res = await fetch(`/Sandbox/Delete/${encodeURIComponent(id)}`, {
                        method: "POST",
                        headers: { "RequestVerificationToken": antiForgeryToken }
                    });
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    tr.remove();
                    const tbody = document.getElementById("sb-runs-tbody");
                    const remaining = tbody.querySelectorAll("tr").length;
                    document.getElementById("sb-run-count-badge").textContent = String(remaining);
                    if (remaining === 0) {
                        tbody.innerHTML = `<tr id="sb-empty-runs-row"><td colspan="6" class="text-center text-muted py-4">No saved runs yet. Run a trace above and click <strong>Save Run to Neon</strong>.</td></tr>`;
                    }
                } catch (err) {
                    neonFeedback.className = "small mt-2 fw-semibold text-danger";
                    neonFeedback.textContent = `Delete failed: ${err.message}.`;
                }
            }
        });

        selectTopic("BST");
    });
</script>