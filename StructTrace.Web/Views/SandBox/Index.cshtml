        const codeEditor = document.getElementById("sb-code-editor");
        const editorMeta = document.getElementById("sb-editor-meta");
        const simulateBtn = document.getElementById("sb-simulate-btn");
        const saveNeonBtn = document.getElementById("sb-save-neon-btn");
        const copyCodeBtn = document.getElementById("sb-copy-code-btn");
        const resetCodeBtn = document.getElementById("sb-reset-code-btn");
        const consoleOutput = document.getElementById("sb-console-output");
        const neonFeedback = document.getElementById("sb-neon-feedback");

        function parseInts(raw) {
            return raw.split(",")
                .map(s => parseInt(s.trim(), 10))
                .filter(n => !Number.isNaN(n))
                .slice(0, 15);
        }

        function cloneBst(node) {
            if (!node) return null;
            return { key: node.key, left: cloneBst(node.left), right: cloneBst(node.right) };
        }

        function buildFrames(topic, rawInput) {
            if (topic === "BST") {
                const nums = parseInts(rawInput);
                if (!nums.length) return [{ type: "BST", root: null, active: null, comparing: [], inserted: [], caption: "Enter at least one integer." }];
                const list = [];
                let root = null;
                const inserted = [];

                for (const val of nums) {
                    if (!root) {
                        root = { key: val, left: null, right: null };
                        inserted.push(val);
                        list.push({ type: "BST", root: cloneBst(root), active: val, comparing: [], inserted: [...inserted], caption: `Inserted ${val} as root node.` });
                        continue;
                    }
                    let curr = root;
                    const path = [];
                    while (curr) {
                        path.push(curr.key);
                        if (val === curr.key) {
                            list.push({ type: "BST", root: cloneBst(root), active: curr.key, comparing: [...path], inserted: [...inserted], caption: `Duplicate key ${val} ignored.` });
                            break;
                        } else if (val < curr.key) {
                            if (!curr.left) {
                                curr.left = { key: val, left: null, right: null };
                                inserted.push(val);
                                list.push({ type: "BST", root: cloneBst(root), active: val, comparing: [...path], inserted: [...inserted], caption: `${val} < ${curr.key}: inserted ${val} as left child of ${curr.key}.` });
                                break;
                            }
                            curr = curr.left;
                        } else {
                            if (!curr.right) {
                                curr.right = { key: val, left: null, right: null };
                                inserted.push(val);
                                list.push({ type: "BST", root: cloneBst(root), active: val, comparing: [...path], inserted: [...inserted], caption: `${val} > ${curr.key}: inserted ${val} as right child of ${curr.key}.` });
                                break;
                            }
                            curr = curr.right;
                        }
                    }
                }
                return list;
            }

            if (topic === "LinkedList") {
                const nums = parseInts(rawInput);
                if (!nums.length) return [{ type: "LinkedList", items: [], activeIdx: -1, caption: "Empty list." }];
                const list = [];
                const items = [];
                nums.forEach((v, i) => {
                    items.push(v);
                    list.push({
                        type: "LinkedList",
                        items: [...items],
                        activeIdx: i,
                        caption: i === 0 ? `Created HEAD node with value ${v}.` : `Linked tail.next -> ${v} and updated TAIL pointer.`
                    });
                });
                return list;
            }

            if (topic === "Stack") {
                const tokens = rawInput.split(",").map(s => s.trim()).filter(Boolean);
                const list = [];
                const stack = [];
                for (const tok of tokens) {
                    const lower = tok.toLowerCase();
                    if (lower.startsWith("pop")) {
                        if (stack.length === 0) {
                            list.push({ type: "Stack", items: [], activeIdx: -1, caption: "Stack Underflow: cannot pop from empty stack." });
                        } else {
                            const popped = stack.pop();
                            list.push({ type: "Stack", items: [...stack], activeIdx: stack.length - 1, caption: `Popped ${popped} from top. New size = ${stack.length}.` });
                        }
                    } else {
                        const num = parseInt(tok.replace(/[^0-9-]/g, ""), 10);
                        if (!Number.isNaN(num)) {
                            stack.push(num);
                            list.push({ type: "Stack", items: [...stack], activeIdx: stack.length - 1, caption: `Pushed ${num} onto top.` });
                        }
                    }
                }
                return list.length ? list : [{ type: "Stack", items: [], activeIdx: -1, caption: "No stack operations parsed." }];
            }

            if (topic === "MinHeap") {
                const nums = parseInts(rawInput);
                if (!nums.length) return [{ type: "MinHeap", heap: [], activeIdx: -1, swapIdx: -1, caption: "Empty heap." }];
                const list = [];
                const heap = [];
                for (const val of nums) {
                    heap.push(val);
                    let i = heap.length - 1;
                    list.push({ type: "MinHeap", heap: [...heap], activeIdx: i, swapIdx: -1, caption: `Appended ${val} at index ${i}.` });
                    while (i > 0) {
                        const parent = Math.floor((i - 1) / 2);
                        if (heap[i] < heap[parent]) {
                            [heap[i], heap[parent]] = [heap[parent], heap[i]];
                            list.push({ type: "MinHeap", heap: [...heap], activeIdx: parent, swapIdx: i, caption: `SiftUp: swapped ${heap[parent]} with parent ${heap[i]}.` });
                            i = parent;
                        } else {
                            break;
                        }
                    }
                }
                return list;
            }

            if (topic === "BFS") {
                const edges = [];
                const adj = {};
                rawInput.split(",").map(s => s.trim()).filter(Boolean).forEach(pair => {
                    const [u, v] = pair.split("-").map(x => x.trim().toUpperCase());
                    if (u && v) {
                        edges.push([u, v]);
                        adj[u] = adj[u] || [];
                        adj[v] = adj[v] || [];
                        if (!adj[u].includes(v)) adj[u].push(v);
                        if (!adj[v].includes(u)) adj[v].push(u);
                    }
                });
                const nodes = Object.keys(adj).sort();
                if (!nodes.length) return [{ type: "Graph", nodes: [], edges: [], visited: [], frontier: [], active: null, caption: "Enter edges like A-B, A-C." }];
                nodes.forEach(n => adj[n].sort());

                const startMatch = (testArgInput.value || "").match(/start\s*=\s*([A-Za-z0-9]+)/i);
                const start = (startMatch && adj[startMatch[1].toUpperCase()]) ? startMatch[1].toUpperCase() : nodes[0];

                const list = [];
                const visited = new Set([start]);
                const settled = [];
                const q = [start];
                list.push({ type: "Graph", directed: false, nodes, edges, visited: [], frontier: [...q], active: null, caption: `Enqueued start vertex ${start}.` });

                while (q.length) {
                    const u = q.shift();
                    settled.push(u);
                    list.push({ type: "Graph", directed: false, nodes, edges, visited: [...settled], frontier: [...q], active: u, caption: `Dequeued ${u} -> Visited: [${settled.join(", ")}].` });
                    for (const v of adj[u]) {
                        if (!visited.has(v)) {
                            visited.add(v);
                            q.push(v);
                            list.push({ type: "Graph", directed: false, nodes, edges, visited: [...settled], frontier: [...q], active: u, caption: `Discovered ${v} from ${u}; enqueued ${v}.` });
                        }
                    }
                }
                return list;
            }

            if (topic === "Dijkstra") {
                const edges = [];
                const adj = {};
                rawInput.split(",").map(s => s.trim()).filter(Boolean).forEach(item => {
                    const [pair, wStr] = item.split(":");
                    const [u, v] = (pair || "").split("-").map(x => x.trim().toUpperCase());
                    const w = parseInt((wStr || "1").trim(), 10) || 1;
                    if (u && v) {
                        edges.push([u, v, w]);
                        adj[u] = adj[u] || [];
                        adj[v] = adj[v] || [];
                        adj[u].push({ to: v, w });
                    }
                });
                const nodes = Object.keys(adj).sort();
                if (!nodes.length) return [{ type: "Graph", nodes: [], edges: [], visited: [], frontier: [], active: null, caption: "Enter weighted edges like A-B:4, A-C:2." }];

                const startMatch = (testArgInput.value || "").match(/start\s*=\s*([A-Za-z0-9]+)/i);
                const start = (startMatch && adj[startMatch[1].toUpperCase()]) ? startMatch[1].toUpperCase() : nodes[0];

                const dist = {};
                nodes.forEach(n => dist[n] = Infinity);
                dist[start] = 0;
                const settled = [];
                const pq = [{ node: start, d: 0 }];
                const list = [{ type: "Graph", directed: true, nodes, edges, dist: { ...dist }, visited: [], frontier: [start], active: start, caption: `Initialized dist[${start}] = 0.` }];

                while (pq.length) {
                    pq.sort((a, b) => a.d - b.d);
                    const { node: u, d } = pq.shift();
                    if (d > dist[u]) continue;
                    if (!settled.includes(u)) settled.push(u);
                    list.push({ type: "Graph", directed: true, nodes, edges, dist: { ...dist }, visited: [...settled], frontier: pq.map(x => x.node), active: u, caption: `Settled ${u} with shortest distance ${d}.` });

                    for (const { to: v, w } of adj[u]) {
                        if (dist[u] + w < dist[v]) {
                            dist[v] = dist[u] + w;
                            pq.push({ node: v, d: dist[v] });
                            list.push({ type: "Graph", directed: true, nodes, edges, dist: { ...dist }, visited: [...settled], frontier: pq.map(x => x.node), active: u, caption: `Relaxed edge ${u}->${v} with weight ${w}: dist[${v}] = ${dist[v]}.` });
                        }
                    }
                }
                return list;
            }

            return [];
        }

        function renderFrame(frame) {
            const w = 540, h = 275;
            const dpr = window.devicePixelRatio || 1;
            canvas.width = w * dpr;
            canvas.height = h * dpr;
            canvas.style.width = `${w}px`;
            canvas.style.height = `${h}px`;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.clearRect(0, 0, w, h);

            if (!frame) return;

            if (frame.type === "BST" && frame.root) {
                function drawTree(node, x, y, dx) {
                    if (!node) return;
                    if (node.left) {
                        ctx.strokeStyle = "#94a3b8";
                        ctx.lineWidth = 2;
                        ctx.beginPath();
                        ctx.moveTo(x, y);
                        ctx.lineTo(x - dx, y + 58);
                        ctx.stroke();
                        drawTree(node.left, x - dx, y + 58, Math.max(dx * 0.52, 24));
                    }
                    if (node.right) {
                        ctx.strokeStyle = "#94a3b8";
                        ctx.lineWidth = 2;
                        ctx.beginPath();
                        ctx.moveTo(x, y);
                        ctx.lineTo(x + dx, y + 58);
                        ctx.stroke();
                        drawTree(node.right, x + dx, y + 58, Math.max(dx * 0.52, 24));
                    }
                    const isActive = frame.active === node.key;
                    const isComp = (frame.comparing || []).includes(node.key);
                    ctx.fillStyle = isActive ? "#2563eb" : isComp ? "#fef3c7" : "#dcfce7";
                    ctx.strokeStyle = isActive ? "#1d4ed8" : isComp ? "#d97706" : "#16a34a";
                    ctx.lineWidth = 2.5;
                    ctx.beginPath();
                    ctx.arc(x, y, 18, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();

                    ctx.fillStyle = isActive ? "#ffffff" : "#0f172a";
                    ctx.font = "bold 12px Consolas, monospace";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    ctx.fillText(String(node.key), x, y);
                }
                drawTree(frame.root, w / 2, 42, 120);
            } else if (frame.type === "LinkedList") {
                const startX = 24, y = 115, boxW = 68, boxH = 42, gap = 22;
                frame.items.forEach((val, i) => {
                    const x = startX + i * (boxW + gap);
                    if (x + boxW > w - 40) return;
                    const active = i === frame.activeIdx;
                    ctx.fillStyle = active ? "#eff6ff" : "#ffffff";
                    ctx.strokeStyle = active ? "#2563eb" : "#475569";
                    ctx.lineWidth = 2;
                    ctx.fillRect(x, y, boxW, boxH);
                    ctx.strokeRect(x, y, boxW, boxH);

                    ctx.fillStyle = "#0f172a";
                    ctx.font = "bold 13px Consolas, monospace";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    ctx.fillText(String(val), x + boxW / 2, y + boxH / 2);

                    if (i === 0) {
                        ctx.fillStyle = "#2563eb";
                        ctx.font = "bold 10px sans-serif";
                        ctx.fillText("HEAD", x + boxW / 2, y - 10);
                    }
                    if (i === frame.items.length - 1) {
                        ctx.fillStyle = "#16a34a";
                        ctx.font = "bold 10px sans-serif";
                        ctx.fillText("TAIL", x + boxW / 2, y + boxH + 13);
                    }

                    ctx.strokeStyle = "#475569";
                    ctx.beginPath();
                    ctx.moveTo(x + boxW, y + boxH / 2);
                    ctx.lineTo(x + boxW + gap - 4, y + boxH / 2);
                    ctx.stroke();
                });
            } else if (frame.type === "Stack") {
                const boxW = 140, boxH = 34, baseX = (w - boxW) / 2, baseY = 230;
                ctx.strokeStyle = "#334155";
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(baseX - 8, 35);
                ctx.lineTo(baseX - 8, baseY + 6);
                ctx.lineTo(baseX + boxW + 8, baseY + 6);
                ctx.lineTo(baseX + boxW + 8, 35);
                ctx.stroke();

                frame.items.forEach((val, idx) => {
                    const y = baseY - (idx + 1) * (boxH + 5);
                    const isTop = idx === frame.items.length - 1;
                    ctx.fillStyle = isTop ? "#2563eb" : "#dcfce7";
                    ctx.strokeStyle = isTop ? "#1d4ed8" : "#16a34a";
                    ctx.lineWidth = 2;
                    ctx.fillRect(baseX, y, boxW, boxH);
                    ctx.strokeRect(baseX, y, boxW, boxH);

                    ctx.fillStyle = isTop ? "#ffffff" : "#0f172a";
                    ctx.font = "bold 13px Consolas, monospace";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    ctx.fillText(isTop ? `${val}  TOP` : String(val), baseX + boxW / 2, y + boxH / 2);
                });
            } else if (frame.type === "MinHeap") {
                const arr = frame.heap || [];
                const coords = [];
                arr.forEach((_, i) => {
                    const level = Math.floor(Math.log2(i + 1));
                    const posInLevel = i - (Math.pow(2, level) - 1);
                    const slots = Math.pow(2, level);
                    coords[i] = { x: (w / (slots + 1)) * (posInLevel + 1), y: 34 + level * 56 };
                });

                arr.forEach((_, i) => {
                    if (i === 0) return;
                    const p = Math.floor((i - 1) / 2);
                    ctx.strokeStyle = "#94a3b8";
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(coords[p].x, coords[p].y);
                    ctx.lineTo(coords[i].x, coords[i].y);
                    ctx.stroke();
                });

                arr.forEach((val, i) => {
                    const isAct = i === frame.activeIdx;
                    const isSwap = i === frame.swapIdx;
                    ctx.fillStyle = isAct ? "#2563eb" : isSwap ? "#fef3c7" : "#dcfce7";
                    ctx.strokeStyle = isAct ? "#1d4ed8" : isSwap ? "#d97706" : "#16a34a";
                    ctx.lineWidth = 2.2;
                    ctx.beginPath();
                    ctx.arc(coords[i].x, coords[i].y, 17, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();

                    ctx.fillStyle = isAct ? "#ffffff" : "#0f172a";
                    ctx.font = "bold 12px Consolas, monospace";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    ctx.fillText(String(val), coords[i].x, coords[i].y);
                });

                const cellW = 38, startX = (w - arr.length * cellW) / 2;
                arr.forEach((val, i) => {
                    const x = startX + i * cellW;
                    ctx.fillStyle = i === frame.activeIdx ? "#dbeafe" : "#ffffff";
                    ctx.strokeStyle = "#64748b";
                    ctx.lineWidth = 1.5;
                    ctx.fillRect(x, 224, cellW, 28);
                    ctx.strokeRect(x, 224, cellW, 28);
                    ctx.fillStyle = "#0f172a";
                    ctx.font = "bold 11px Consolas, monospace";
                    ctx.fillText(String(val), x + cellW / 2, 238);
                });
            } else if (frame.type === "Graph") {
                const nodes = frame.nodes || [];
                const pos = {};
                const cx = w / 2, cy = 138, rx = 195, ry = 92;
                nodes.forEach((n, i) => {
                    const angle = Math.PI + (i / Math.max(nodes.length, 1)) * Math.PI * 2;
                    pos[n] = { x: cx + rx * Math.cos(angle), y: cy + ry * Math.sin(angle) };
                });

                (frame.edges || []).forEach(([u, v, weight]) => {
                    if (!pos[u] || !pos[v]) return;
                    ctx.strokeStyle = "#94a3b8";
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(pos[u].x, pos[u].y);
                    ctx.lineTo(pos[v].x, pos[v].y);
                    ctx.stroke();

                    if (weight !== undefined) {
                        const mx = (pos[u].x + pos[v].x) / 2;
                        const my = (pos[u].y + pos[v].y) / 2;
                        ctx.fillStyle = "#ffffff";
                        ctx.fillRect(mx - 10, my - 8, 20, 16);
                        ctx.fillStyle = "#1e293b";
                        ctx.font = "bold 11px Consolas, monospace";
                        ctx.textAlign = "center";
                        ctx.textBaseline = "middle";
                        ctx.fillText(String(weight), mx, my);
                    }
                });

                nodes.forEach(n => {
                    const isAct = frame.active === n;
                    const isVis = (frame.visited || []).includes(n);
                    const isFront = (frame.frontier || []).includes(n);
                    ctx.fillStyle = isAct ? "#2563eb" : isVis ? "#dcfce7" : isFront ? "#fef3c7" : "#ffffff";
                    ctx.strokeStyle = isAct ? "#1d4ed8" : isVis ? "#16a34a" : isFront ? "#d97706" : "#475569";
                    ctx.lineWidth = 2.5;
                    ctx.beginPath();
                    ctx.arc(pos[n].x, pos[n].y, 20, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();

                    ctx.fillStyle = isAct ? "#ffffff" : "#0f172a";
                    ctx.font = "bold 13px Consolas, monospace";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    const dVal = frame.dist ? (frame.dist[n] === Infinity ? "∞" : frame.dist[n]) : null;
                    ctx.fillText(dVal !== null ? `${n}:${dVal}` : n, pos[n].x, pos[n].y);
                });
            }
        }

        function updatePlaybackUI() {
            const total = Math.max(frames.length, 1);
            const current = frames[frameIndex];
            stepBadge.textContent = `Step ${frameIndex + 1} / ${total}`;
            stepCaption.textContent = current ? current.caption : "Ready.";
            renderFrame(current);
        }

        function stopAutoPlay() {
            if (playTimer) {
                clearInterval(playTimer);
                playTimer = null;
                playBtn.textContent = "Play";
            }
        }

        function regenerateTrace() {
            stopAutoPlay();
            frames = buildFrames(currentTopic, traceInputEl.value);
            frameIndex = 0;
            updatePlaybackUI();
        }

        function selectTopic(topicKey, preserveEditor = false) {
            if (!TOPICS[topicKey]) return;
            currentTopic = topicKey;
            const cfg = TOPICS[topicKey];

            topicBtns.forEach(b => b.classList.toggle("active", b.dataset.topic === topicKey));
            titleEl.textContent = cfg.title;
            descEl.textContent = cfg.desc;
            badgeEl.textContent = cfg.badge;
            timeEl.textContent = cfg.time;
            spaceEl.textContent = cfg.space;
            traceLabelEl.textContent = cfg.inputLabel;
            traceInputEl.value = cfg.defaultInput;
            testArgInput.value = cfg.defaultArg;

            if (!preserveEditor) {
                codeEditor.value = cfg.templates[currentLang] || "";
            }
            regenerateTrace();
        }

        topicBtns.forEach(btn => {
            btn.addEventListener("click", () => selectTopic(btn.dataset.topic));
        });

        document.getElementById("sb-preset-balanced").addEventListener("click", () => {
            traceInputEl.value = TOPICS[currentTopic].defaultInput;
            regenerateTrace();
        });
        document.getElementById("sb-preset-edge").addEventListener("click", () => {
            traceInputEl.value = TOPICS[currentTopic].edgeInput;
            regenerateTrace();
        });
        document.getElementById("sb-preset-random").addEventListener("click", () => {
            if (currentTopic === "BST" || currentTopic === "LinkedList" || currentTopic === "MinHeap") {
                const set = new Set();
                while (set.size < 7) set.add(Math.floor(Math.random() * 89) + 10);
                traceInputEl.value = Array.from(set).join(", ");
            } else if (currentTopic === "Stack") {
                const a = Math.floor(Math.random() * 50) + 10;
                const b = Math.floor(Math.random() * 50) + 10;
                const c = Math.floor(Math.random() * 50) + 10;
                traceInputEl.value = `push ${a}, push ${b}, pop, push ${c}`;
            }
            regenerateTrace();
        });

        generateBtn.addEventListener("click", regenerateTrace);

        firstBtn.addEventListener("click", () => { stopAutoPlay(); frameIndex = 0; updatePlaybackUI(); });
        prevBtn.addEventListener("click", () => { stopAutoPlay(); if (frameIndex > 0) { frameIndex--; updatePlaybackUI(); } });
        nextBtn.addEventListener("click", () => { stopAutoPlay(); if (frameIndex < frames.length - 1) { frameIndex++; updatePlaybackUI(); } });
        lastBtn.addEventListener("click", () => { stopAutoPlay(); frameIndex = Math.max(frames.length - 1, 0); updatePlaybackUI(); });

        playBtn.addEventListener("click", () => {
            if (playTimer) {
                stopAutoPlay();
                return;
            }
            if (frameIndex >= frames.length - 1) frameIndex = 0;
            playBtn.textContent = "Pause";
            playTimer = setInterval(() => {
                if (frameIndex < frames.length - 1) {
                    frameIndex++;
                    updatePlaybackUI();
                } else {
                    stopAutoPlay();
                }
            }, parseInt(speedSelect.value, 10) || 550);
        });

        document.addEventListener("keydown", (e) => {
            const tag = (document.activeElement?.tagName || "").toUpperCase();
            if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
            if (e.key === "ArrowLeft" && frameIndex > 0) {
                stopAutoPlay();
                frameIndex--;
                updatePlaybackUI();
            } else if (e.key === "ArrowRight" && frameIndex < frames.length - 1) {
                stopAutoPlay();
                frameIndex++;
                updatePlaybackUI();
            }
        });

        langSelect.addEventListener("change", () => {
            currentLang = langSelect.value;
            editorMeta.textContent = LANG_META[currentLang] || "";
            codeEditor.value = TOPICS[currentTopic].templates[currentLang] || "";
        });

        codeEditor.addEventListener("keydown", (e) => {
            if (e.key === "Tab") {
                e.preventDefault();
                const start = codeEditor.selectionStart;
                const end = codeEditor.selectionEnd;
                codeEditor.value = codeEditor.value.substring(0, start) + "    " + codeEditor.value.substring(end);
                codeEditor.selectionStart = codeEditor.selectionEnd = start + 4;
            }
        });

        copyCodeBtn.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(codeEditor.value);
                copyCodeBtn.textContent = "Copied!";
                setTimeout(() => copyCodeBtn.textContent = "Copy", 1400);
            } catch {
                copyCodeBtn.textContent = "Failed";
            }
        });

        resetCodeBtn.addEventListener("click", () => {
            codeEditor.value = TOPICS[currentTopic].templates[currentLang] || "";
        });

        function runSimulation() {
            regenerateTrace();
            const summaryLines = frames.map((f, idx) => `[Step ${idx + 1}] ${f.caption}`);
            const arg = testArgInput.value.trim();
            const header = `=== ${TOPICS[currentTopic].title} | ${currentLang.toUpperCase()} | Arg: ${arg || "none"} ===`;
            const result = `${header}\n${summaryLines.join("\n")}\n\nCompleted ${frames.length} trace frames in 0.${Math.floor(Math.random() * 8) + 1}ms.`;
            consoleOutput.textContent = result;
            return result;
        }

        simulateBtn.addEventListener("click", runSimulation);

        saveNeonBtn.addEventListener("click", async () => {
            const outputSummary = frames.length
                ? frames[frames.length - 1].caption
                : runSimulation().split("\n")[1] || "Executed trace";

            const tokenInput = document.querySelector("#sb-antiforgery-form input[name='__RequestVerificationToken']");
            const antiForgeryToken = tokenInput ? tokenInput.value : "";

            const payload = {
                topic: currentTopic,
                language: currentLang,
                input: traceInputEl.value.trim(),
                output: outputSummary,
                code: codeEditor.value
            };

            saveNeonBtn.disabled = true;
            neonFeedback.className = "small mt-2 fw-semibold text-primary";
            neonFeedback.textContent = "Saving execution trace to Neon PostgreSQL...";

            try {
                const response = await fetch("/Sandbox/Save", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": antiForgeryToken
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const data = await response.json().catch(() => ({}));
                const savedId = data.id || data.Id || "";
                const savedAt = data.createdAt || data.CreatedAt || new Date().toLocaleString();

                appendRunRow({
                    id: savedId,
                    topic: payload.topic,
                    language: payload.language,
                    input: payload.input,
                    output: payload.output,
                    code: payload.code,
                    createdAt: savedAt
                });

                neonFeedback.className = "small mt-2 fw-semibold text-success";
                neonFeedback.textContent = "Saved to Neon PostgreSQL.";
            } catch (err) {
                neonFeedback.className = "small mt-2 fw-semibold text-danger";
                neonFeedback.textContent = `Could not persist to /Sandbox/Save: ${err.message}.`;
            } finally {
                saveNeonBtn.disabled = false;
            }
        });

        function appendRunRow(run) {
            const emptyRow = document.getElementById("sb-empty-runs-row");
            if (emptyRow) emptyRow.remove();

            const tbody = document.getElementById("sb-runs-tbody");
            const tr = document.createElement("tr");
            tr.dataset.runId = run.id || "";
            tr.dataset.topic = run.topic;
            tr.dataset.language = run.language;
            tr.dataset.input = run.input;
            tr.dataset.code = run.code;

            tr.innerHTML = `
                <td class="fw-semibold"></td>
                <td><span class="badge bg-dark text-uppercase"></span></td>
                <td class="font-monospace small"></td>
                <td class="small text-muted" style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"></td>
                <td class="small text-muted"></td>
                <td class="text-end">
                    <button type="button" class="btn btn-outline-primary btn-sm sb-load-run-btn">Load</button>
                    ${run.id ? `<button type="button" class="btn btn-outline-danger btn-sm sb-delete-run-btn" data-id="${run.id}">Delete</button>` : ""}
                </td>
            `;
            tr.children[0].textContent = run.topic;
            tr.children[1].querySelector("span").textContent = run.language;
            tr.children[2].textContent = run.input;
            tr.children[3].textContent = run.output;
            tr.children[3].title = run.output;
            tr.children[4].textContent = run.createdAt;

            tbody.prepend(tr);
            const badge = document.getElementById("sb-run-count-badge");
            badge.textContent = String(tbody.querySelectorAll("tr").length);
        }

        document.getElementById("sb-runs-tbody").addEventListener("click", async (e) => {
            const loadBtn = e.target.closest(".sb-load-run-btn");
            if (loadBtn) {
                const tr = loadBtn.closest("tr");
                const topic = tr.dataset.topic || "BST";
                const lang = (tr.dataset.language || "cpp").toLowerCase();
                selectTopic(TOPICS[topic] ? topic : "BST", true);

                if (LANG_META[lang]) {
                    currentLang = lang;
                    langSelect.value = lang;
                    editorMeta.textContent = LANG_META[lang];
                }
                if (tr.dataset.input) {
                    traceInputEl.value = tr.dataset.input;
                    regenerateTrace();
                }
                if (tr.dataset.code) {
                    codeEditor.value = tr.dataset.code;
                }
                neonFeedback.className = "small mt-2 fw-semibold text-primary";
                neonFeedback.textContent = `Loaded saved ${topic} run into workbench.`;
                window.scrollTo({ top: 0, behavior: "smooth" });
                return;
            }

            const delBtn = e.target.closest(".sb-delete-run-btn");
            if (delBtn) {
                const id = delBtn.dataset.id;
                const tr = delBtn.closest("tr");
                const tokenInput = document.querySelector("#sb-antiforgery-form input[name='__RequestVerificationToken']");
                const antiForgeryToken = tokenInput ? tokenInput.value : "";

                try {
                    const res = await fetch(`/Sandbox/Delete/${encodeURIComponent(id)}`, {
                        method: "POST",
                        headers: { "RequestVerificationToken": antiForgeryToken }
                    });
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    tr.remove();
                    const tbody = document.getElementById("sb-runs-tbody");
                    const remaining = tbody.querySelectorAll("tr").length;
                    document.getElementById("sb-run-count-badge").textContent = String(remaining);
                    if (remaining === 0) {
                        tbody.innerHTML = `<tr id="sb-empty-runs-row"><td colspan="6" class="text-center text-muted py-4">No saved runs in Neon yet. Run a trace above and click <strong>Save Run to Neon</strong>.</td></tr>`;
                    }
                } catch (err) {
                    neonFeedback.className = "small mt-2 fw-semibold text-danger";
                    neonFeedback.textContent = `Delete failed: ${err.message}.`;
                }
            }
        });

        selectTopic("BST");
    });
</script>