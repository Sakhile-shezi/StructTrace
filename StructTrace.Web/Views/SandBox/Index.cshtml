@using System.Reflection
@using System.Collections
@{
    ViewData["Title"] = "Code Sandbox";

    var existingRuns = new List<Dictionary<string, string>>();
    if (Model != null)
    {
        var modelType = Model.GetType();
        var runsProp = modelType.GetProperty("SavedRuns")
                    ?? modelType.GetProperty("RecentRuns")
                    ?? modelType.GetProperty("Runs")
                    ?? modelType.GetProperty("ExecutionLogs");

        if (runsProp?.GetValue(Model) is IEnumerable enumerableRuns)
        {
            foreach (var item in enumerableRuns)
            {
                if (item == null) continue;
                var t = item.GetType();
                string ReadProp(params string[] names)
                {
                    foreach (var n in names)
                    {
                        var p = t.GetProperty(n, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
                        var val = p?.GetValue(item);
                        if (val != null) return val.ToString() ?? "";
                    }
                    return "";
                }

                existingRuns.Add(new Dictionary<string, string>
                {
                    ["Id"] = ReadProp("Id", "RunId"),
                    ["Topic"] = ReadProp("Topic", "Structure", "DataStructure", "Algorithm"),
                    ["Language"] = ReadProp("Language", "ProgLanguage"),
                    ["Input"] = ReadProp("Input", "TestInput", "Arguments"),
                    ["Output"] = ReadProp("Output", "ExecutionOutput", "Notes", "Result"),
                    ["Code"] = ReadProp("Code", "SourceCode"),
                    ["CreatedAt"] = ReadProp("CreatedAt", "Timestamp", "SavedAt")
                });
            }
        }
    }
}

<style>
    .sb-pill-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 1rem;
    }

    .sb-topic-btn {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #1e293b;
        font-weight: 600;
        font-size: 0.84rem;
        padding: 0.4rem 0.78rem;
        border-radius: 8px;
        transition: all 0.15s ease;
    }

        .sb-topic-btn:hover {
            border-color: #2563eb;
            color: #2563eb;
            background: #eff6ff;
        }

        .sb-topic-btn.active {
            background: #2563eb;
            border-color: #2563eb;
            color: #ffffff;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
        }

    .sb-overview-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .sb-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .sb-panel-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 0.85rem 1.15rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
    }

    .sb-panel-body {
        padding: 1.15rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .sb-canvas-box {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
        padding: 0.5rem;
        margin-bottom: 0.75rem;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow-x: auto;
    }

    .sb-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.78rem;
        color: #475569;
        margin-bottom: 0.75rem;
    }

    .sb-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 0.35rem;
    }

    .sb-editor-wrapper {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .sb-code-area {
        font-family: "Cascadia Code", Consolas, "Courier New", monospace;
        font-size: 0.86rem;
        line-height: 1.55;
        background: #0f172a;
        color: #f8fafc;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 0.9rem 1rem;
        min-height: 310px;
        resize: vertical;
        tab-size: 4;
    }

        .sb-code-area:focus {
            outline: none;
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
        }

    .sb-console-box {
        font-family: "Cascadia Code", Consolas, "Courier New", monospace;
        font-size: 0.82rem;
        line-height: 1.5;
        background: #020617;
        color: #38bdf8;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 0.75rem 0.9rem;
        min-height: 112px;
        max-height: 175px;
        overflow-y: auto;
        white-space: pre-wrap;
    }

    .sb-step-caption {
        background: #eff6ff;
        border-left: 4px solid #2563eb;
        border-radius: 6px;
        padding: 0.6rem 0.85rem;
        font-size: 0.88rem;
        color: #1e3a8a;
        font-weight: 500;
    }

    .sb-preset-chip {
        font-size: 0.75rem;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        border: 1px solid #cbd5e1;
        background: #f1f5f9;
        color: #334155;
        cursor: pointer;
        font-weight: 600;
    }

        .sb-preset-chip:hover {
            background: #e2e8f0;
            color: #0f172a;
        }
</style>

<div class="pb-4">
    <form id="sb-antiforgery-form" hidden>
        @Html.AntiForgeryToken()
    </form>

    <!-- 10-Topic Switcher Bar -->
    <div class="sb-pill-bar" role="tablist" aria-label="Data Structure & Algorithm Topics">
        <button type="button" class="sb-topic-btn active" data-topic="BST">Binary Search Tree</button>
        <button type="button" class="sb-topic-btn" data-topic="LinkedList">Singly Linked List</button>
        <button type="button" class="sb-topic-btn" data-topic="DoublyLinkedList">Doubly Linked List</button>
        <button type="button" class="sb-topic-btn" data-topic="Stack">Stack</button>
        <button type="button" class="sb-topic-btn" data-topic="Queue">Queue</button>
        <button type="button" class="sb-topic-btn" data-topic="MinHeap">Binary Min-Heap</button>
        <button type="button" class="sb-topic-btn" data-topic="HashTable">Hash Table</button>
        <button type="button" class="sb-topic-btn" data-topic="BFS">Graph BFS</button>
        <button type="button" class="sb-topic-btn" data-topic="DFS">Graph DFS</button>
        <button type="button" class="sb-topic-btn" data-topic="Dijkstra">Dijkstra Shortest Path</button>
    </div>

    <!-- Active Topic Overview Banner -->
    <div class="sb-overview-card">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
            <div>
                <h1 id="sb-topic-title" class="h3 fw-bold mb-1">Binary Search Tree</h1>
                <p id="sb-topic-desc" class="text-muted mb-0">
                    A Binary Search Tree maintains the invariant that every node in the left subtree has a key strictly less than the parent, and every node in the right subtree has a key greater than the parent.
                </p>
            </div>
            <span id="sb-topic-badge" class="badge bg-primary px-3 py-2">Hierarchical Trees</span>
        </div>
        <div class="small mt-2 pt-2 border-top d-flex flex-wrap gap-3">
            <span><strong>Time Complexity:</strong> <code id="sb-time-complexity">Avg O(log n) | Worst O(n)</code></span>
            <span><strong>Space Complexity:</strong> <code id="sb-space-complexity">O(n)</code></span>
            <span class="text-muted ms-auto d-none d-md-inline">Tip: Use <kbd>←</kbd> / <kbd>→</kbd> keys to step through frames</span>
        </div>
    </div>

    <!-- Two-Column Workbench -->
    <div class="row g-4 mb-4">
        <!-- LEFT PANEL: Step-by-Step Execution Visualizer -->
        <div class="col-lg-6">
            <div class="sb-panel">
                <div class="sb-panel-header">
                    <span class="fw-bold">Step-by-Step Execution Visualizer</span>
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        <span class="small text-muted me-1">Presets:</span>
                        <button type="button" class="sb-preset-chip" id="sb-preset-balanced">Balanced</button>
                        <button type="button" class="sb-preset-chip" id="sb-preset-edge">Worst-Case</button>
                        <button type="button" class="sb-preset-chip" id="sb-preset-random">Randomize</button>
                    </div>
                </div>

                <div class="sb-panel-body">
                    <label for="sb-trace-input" id="sb-trace-label" class="form-label small fw-semibold text-secondary mb-1">
                        Node Insertion Sequence
                    </label>
                    <div class="input-group mb-3">
                        <input type="text" id="sb-trace-input" class="form-control font-monospace"
                               value="50, 30, 70, 20, 40, 60, 80"
                               placeholder="e.g. 50, 30, 70, 20, 40" />
                        <button type="button" id="sb-generate-btn" class="btn btn-primary fw-semibold">
                            Generate Trace
                        </button>
                    </div>

                    <div class="sb-canvas-box">
                        <canvas id="sb-canvas" width="540" height="275" aria-label="Data Structure Trace Canvas"></canvas>
                    </div>

                    <div class="sb-legend">
                        <span><i class="sb-dot" style="background:#2563eb;"></i>Active / Current</span>
                        <span><i class="sb-dot" style="background:#f59e0b;"></i>Comparing / Frontier</span>
                        <span><i class="sb-dot" style="background:#16a34a;"></i>Inserted / Visited</span>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div class="btn-group" role="group" aria-label="Trace Playback Controls">
                            <button type="button" id="sb-first-btn" class="btn btn-outline-secondary btn-sm" title="First Step">|<</button>
                            <button type="button" id="sb-prev-btn" class="btn btn-outline-secondary btn-sm" title="Previous Step">← Prev</button>
                            <button type="button" id="sb-play-btn" class="btn btn-outline-primary btn-sm fw-semibold" title="Auto-Play">Play</button>
                            <button type="button" id="sb-next-btn" class="btn btn-outline-secondary btn-sm" title="Next Step">Next →</button>
                            <button type="button" id="sb-last-btn" class="btn btn-outline-secondary btn-sm" title="Last Step">>|</button>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <select id="sb-speed-select" class="form-select form-select-sm" style="width: auto;" aria-label="Playback Speed">
                                <option value="950">0.5x</option>
                                <option value="550" selected>1x</option>
                                <option value="250">2x</option>
                            </select>
                            <span id="sb-step-badge" class="badge bg-dark font-monospace px-2 py-2">Step 1 / 1</span>
                        </div>
                    </div>

                    <div id="sb-step-caption" class="sb-step-caption mt-auto" aria-live="polite">
                        Inserted 50 as root.
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: Multi-Language Code Editor & Neon Execution Log -->
        <div class="col-lg-6">
            <div class="sb-panel">
                <div class="sb-panel-header">
                    <span class="fw-bold">Multi-Language Code Editor & Log</span>
                    <div class="d-flex gap-2">
                        <button type="button" id="sb-copy-code-btn" class="btn btn-outline-secondary btn-sm">Copy</button>
                        <button type="button" id="sb-reset-code-btn" class="btn btn-outline-secondary btn-sm">Reset Template</button>
                    </div>
                </div>

                <div class="sb-panel-body">
                    <div class="row g-2 mb-2">
                        <div class="col-sm-4">
                            <label for="sb-lang-select" class="form-label small fw-semibold text-secondary mb-1">Language</label>
                            <select id="sb-lang-select" class="form-select form-select-sm fw-semibold">
                                <option value="cpp" selected>C++</option>
                                <option value="java">Java</option>
                                <option value="python">Python</option>
                                <option value="csharp">C#</option>
                            </select>
                        </div>
                        <div class="col-sm-8">
                            <label for="sb-test-arg-input" class="form-label small fw-semibold text-secondary mb-1">
                                Test Target / Query Argument
                            </label>
                            <input type="text" id="sb-test-arg-input" class="form-control form-control-sm font-monospace"
                                   value="search=40" placeholder="e.g. search=40 or start=A" />
                        </div>
                    </div>

                    <div class="sb-editor-wrapper mb-2">
                        <textarea id="sb-code-editor" class="sb-code-area" spellcheck="false" aria-label="Multi-language source code editor"></textarea>
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small text-muted mt-2">
                            <span id="sb-editor-meta">C++17 • Tab inserts 4 spaces</span>
                            <div class="d-flex gap-2">
                                <button type="button" id="sb-simulate-btn" class="btn btn-outline-primary btn-sm fw-semibold">
                                    ▶ Run Trace & Simulate
                                </button>
                                <button type="button" id="sb-save-neon-btn" class="btn btn-success btn-sm fw-semibold">
                                    Save Run to Neon
                                </button>
                            </div>
                        </div>
                    </div>

                    <label for="sb-console-output" class="form-label small fw-semibold text-secondary mb-1">
                        Execution & Trace Output Console
                    </label>
                    <div id="sb-console-output" class="sb-console-box" aria-live="polite">Ready. Click "Run Trace & Simulate" to execute against the active input sequence, or "Save Run to Neon" to persist your snapshot.</div>
                    <div id="sb-neon-feedback" class="small mt-2 fw-semibold"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- BOTTOM PANEL: Persisted Runs -->
    <div class="sb-panel">
        <div class="sb-panel-header">
            <div>
                <span class="fw-bold">Saved Runs & Execution Log</span>
                <span class="badge bg-secondary ms-2" id="sb-run-count-badge">@existingRuns.Count</span>
            </div>
            <span class="small text-muted">Click <strong>Load</strong> on any persisted run to restore its topic, language, input, and source code.</span>
        </div>
        <div class="sb-panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="sb-runs-table">
                    <thead class="table-light">
                        <tr>
                            <th>Topic</th>
                            <th>Language</th>
                            <th>Input Sequence</th>
                            <th>Execution Summary</th>
                            <th>Saved At</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="sb-runs-tbody">
                        @if (existingRuns.Count == 0)
                        {
                            <tr id="sb-empty-runs-row">
                                <td colspan="6" class="text-center text-muted py-4">
                                    No saved runs yet. Run a trace above and click <strong>Save Run to Neon</strong>.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var run in existingRuns)
                            {
                                var codeAttr = System.Net.WebUtility.HtmlEncode(run["Code"]);
                                var inputAttr = System.Net.WebUtility.HtmlEncode(run["Input"]);
                                var outputText = string.IsNullOrWhiteSpace(run["Output"]) ? "Saved snapshot" : run["Output"];
                                <tr data-run-id="@run["Id"]"
                                    data-topic="@run["Topic"]"
                                    data-language="@run["Language"]"
                                    data-input="@inputAttr"
                                    data-code="@codeAttr">
                                    <td class="fw-semibold">@run["Topic"]</td>
                                    <td><span class="badge bg-dark text-uppercase">@run["Language"]</span></td>
                                    <td class="font-monospace small">@run["Input"]</td>
                                    <td class="small text-muted" style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@outputText">
                                        @outputText
                                    </td>
                                    <td class="small text-muted">@run["CreatedAt"]</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-outline-primary btn-sm sb-load-run-btn">Load</button>
                                        @if (!string.IsNullOrWhiteSpace(run["Id"]))
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm sb-delete-run-btn" data-id="@run["Id"]">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const TOPICS = {
            BST: {
                title: "Binary Search Tree",
                badge: "Hierarchical Trees",
                desc: "Maintains the binary search invariant where left descendants hold smaller keys and right descendants hold larger keys.",
                time: "Avg O(log n) | Worst O(n)",
                space: "O(n)",
                inputLabel: "Node Insertion Sequence",
                defaultInput: "50, 30, 70, 20, 40, 60, 80",
                edgeInput: "10, 20, 30, 40, 50, 60",
                defaultArg: "search=40",
                templates: {
                    cpp: `#include <iostream>\n#include <vector>\nusing namespace std;\n\nstruct Node {\n    int key;\n    Node* left;\n    Node* right;\n    Node(int k) : key(k), left(nullptr), right(nullptr) {}\n};\n\nNode* insert(Node* root, int key) {\n    if (!root) return new Node(key);\n    if (key < root->key) root->left = insert(root->left, key);\n    else if (key > root->key) root->right = insert(root->right, key);\n    return root;\n}\n\nint main() {\n    Node* root = nullptr;\n    for (int v : {50, 30, 70, 20, 40, 60, 80}) root = insert(root, v);\n    cout << "Root: " << root->key << endl;\n    return 0;\n}`,
                    java: `public class BinarySearchTree {\n    static class Node {\n        int key; Node left, right;\n        Node(int key) { this.key = key; }\n    }\n    static Node insert(Node root, int key) {\n        if (root == null) return new Node(key);\n        if (key < root.key) root.left = insert(root.left, key);\n        else if (key > root.key) root.right = insert(root.right, key);\n        return root;\n    }\n}`,
                    python: `class Node:\n    def __init__(self, key: int):\n        self.key = key\n        self.left = None\n        self.right = None\n\ndef insert(root, key: int):\n    if root is None:\n        return Node(key)\n    if key < root.key:\n        root.left = insert(root.left, key)\n    elif key > root.key:\n        root.right = insert(root.right, key)\n    return root`,
                    csharp: `class Node(int key) {\n    public int Key = key;\n    public Node? Left, Right;\n}\nstatic Node Insert(Node? root, int key) {\n    if (root is null) return new Node(key);\n    if (key < root.Key) root.Left = Insert(root.Left, key);\n    else if (key > root.Key) root.Right = Insert(root.Right, key);\n    return root;\n}`
                }
            },
            LinkedList: {
                title: "Singly Linked List",
                badge: "Linear Pointer Structures",
                desc: "Stores elements in heap nodes linked via unidirectional next pointers with O(1) head insertion and O(n) traversal.",
                time: "Head O(1) | Search O(n)",
                space: "O(n)",
                inputLabel: "Append Sequence",
                defaultInput: "10, 20, 30, 40, 50",
                edgeInput: "99",
                defaultArg: "find=30",
                templates: {
                    cpp: `#include <iostream>\nusing namespace std;\n\nstruct Node {\n    int data; Node* next;\n    Node(int d) : data(d), next(nullptr) {}\n};\n\nint main() {\n    Node* head = new Node(10);\n    head->next = new Node(20);\n    cout << "Head: " << head->data << endl;\n    return 0;\n}`,
                    java: `public class SinglyList {\n    static class Node<E> { E data; Node<E> next; Node(E d) { data = d; } }\n    private Node<Integer> head, tail;\n}`,
                    python: `class Node:\n    def __init__(self, data):\n        self.data = data\n        self.next = None`,
                    csharp: `class Node<T>(T data) {\n    public T Data = data;\n    public Node<T>? Next;\n}`
                }
            },
            DoublyLinkedList: {
                title: "Doubly Linked List",
                badge: "Bidirectional Pointer Lists",
                desc: "Each node maintains both prev and next pointers, enabling O(1) tail removal via tail.prev and bidirectional traversal.",
                time: "Head/Tail O(1) | Search O(n)",
                space: "O(n)",
                inputLabel: "Append Sequence",
                defaultInput: "10, 20, 30, 40",
                edgeInput: "5, 15",
                defaultArg: "removeTail",
                templates: {
                    cpp: `#include <iostream>\nusing namespace std;\n\nstruct DNode {\n    int data; DNode* prev; DNode* next;\n    DNode(int d) : data(d), prev(nullptr), next(nullptr) {}\n};\n\nint main() {\n    DNode* a = new DNode(10);\n    DNode* b = new DNode(20);\n    a->next = b; b->prev = a;\n    cout << "b->prev: " << b->prev->data << endl;\n    return 0;\n}`,
                    java: `public class DoublyList<E> {\n    private static class Node<E> { E val; Node<E> prev, next; Node(E v) { val = v; } }\n    private Node<E> head, tail;\n}`,
                    python: `class DNode:\n    def __init__(self, val):\n        self.val = val\n        self.prev = None\n        self.next = None`,
                    csharp: `class DNode<T>(T val) {\n    public T Val = val;\n    public DNode<T>? Prev, Next;\n}`
                }
            },
            Stack: {
                title: "Stack",
                badge: "Restricted Linear ADT",
                desc: "Last-In, First-Out structure supporting O(1) push, pop, and peek exclusively at the top boundary.",
                time: "Push / Pop / Peek O(1)",
                space: "O(n)",
                inputLabel: "Stack Operations",
                defaultInput: "push 15, push 30, push 45, pop, push 60",
                edgeInput: "push 10, pop, pop",
                defaultArg: "peek",
                templates: {
                    cpp: `#include <iostream>\n#include <stack>\nusing namespace std;\n\nint main() {\n    stack<int> st;\n    st.push(15); st.push(30); st.pop();\n    cout << "Top: " << st.top() << endl;\n    return 0;\n}`,
                    java: `import java.util.*;\nvar stack = new ArrayDeque<Integer>();\nstack.push(15); stack.push(30); stack.pop();`,
                    python: `stack = []\nstack.append(15)\nstack.append(30)\nstack.pop()`,
                    csharp: `var stack = new Stack<int>();\nstack.Push(15); stack.Push(30); stack.Pop();`
                }
            },
            Queue: {
                title: "Queue",
                badge: "Restricted Linear ADT",
                desc: "First-In, First-Out structure where items enqueue at the rear and dequeue from the front in O(1) amortized time.",
                time: "Enqueue / Dequeue O(1)",
                space: "O(n)",
                inputLabel: "Queue Operations",
                defaultInput: "enqueue 10, enqueue 20, enqueue 30, dequeue, enqueue 40",
                edgeInput: "enqueue 5, dequeue, dequeue",
                defaultArg: "front",
                templates: {
                    cpp: `#include <iostream>\n#include <queue>\nusing namespace std;\n\nint main() {\n    queue<int> q;\n    q.push(10); q.push(20); q.pop();\n    cout << "Front: " << q.front() << endl;\n    return 0;\n}`,
                    java: `import java.util.*;\nQueue<Integer> q = new ArrayDeque<>();\nq.offer(10); q.offer(20); q.poll();`,
                    python: `from collections import deque\nq = deque([10, 20])\nq.popleft()`,
                    csharp: `var q = new Queue<int>();\nq.Enqueue(10); q.Enqueue(20); q.Dequeue();`
                }
            },
            MinHeap: {
                title: "Binary Min-Heap",
                badge: "Priority Queues",
                desc: "Complete binary tree backed by an array where every parent is <= its children, giving O(1) peekMin and O(log n) siftUp.",
                time: "Insert O(log n) | PeekMin O(1)",
                space: "O(n)",
                inputLabel: "Heap Insertion Sequence",
                defaultInput: "40, 25, 60, 10, 30, 50, 15",
