    public class Dijkstra {
        record Edge(String to, int weight) {}
        record State(String node, int dist) {}

        public static Map<String, Integer> shortestPaths(Map<String, List<Edge>> adj, String src) {
            Map<String, Integer> dist = new HashMap<>();
            adj.keySet().forEach(k -> dist.put(k, Integer.MAX_VALUE));
            dist.put(src, 0);

            PriorityQueue<State> pq = new PriorityQueue<>(Comparator.comparingInt(State::dist));
            pq.offer(new State(src, 0));

            while (!pq.isEmpty()) {
                State cur = pq.poll();
                if (cur.dist() > dist.get(cur.node())) continue;
                for (Edge e : adj.getOrDefault(cur.node(), List.of())) {
                    int nd = cur.dist() + e.weight();
                    if (nd < dist.getOrDefault(e.to(), Integer.MAX_VALUE)) {
                        dist.put(e.to(), nd);
                        pq.offer(new State(e.to(), nd));
                    }
                }
            }
            return dist;
        }
    }`,
