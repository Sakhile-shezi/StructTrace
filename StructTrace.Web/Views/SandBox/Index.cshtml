        const LANG_META = {
            cpp: "C++17 • Tab inserts 4 spaces",
            java: "Java 21 • Tab inserts 4 spaces",
            python: "Python 3.12 • Tab inserts 4 spaces",
            csharp: "C# 13 • Tab inserts 4 spaces"
        };

        let currentTopic = "BST";
        let currentLang = "cpp";
        let frames = [];
        let frameIndex = 0;
        let playTimer = null;

        const topicBtns = document.querySelectorAll(".sb-topic-btn");
        const titleEl = document.getElementById("sb-topic-title");
        const descEl = document.getElementById("sb-topic-desc");
        const badgeEl = document.getElementById("sb-topic-badge");
