@using System.Reflection
@using System.Collections
@using System.Text.Json
@{
    ViewData["Title"] = "Code Sandbox";

    // Saved traces are supplied by SandboxController through ViewBag.SavedTraces.
    // Each SavedTrace stores its editor metadata and execution summary in TraceFramesJson.
    var existingRuns = new List<Dictionary<string, string>>();
    var savedTraceItems = ViewBag.SavedTraces as IEnumerable;

    if (savedTraceItems != null)
    {
        foreach (var item in savedTraceItems)
        {
            if (item == null) continue;

            var itemType = item.GetType();

            string ReadProp(params string[] names)
            {
                foreach (var name in names)
                {
                    var property = itemType.GetProperty(
                        name,
                        BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);

                    var value = property?.GetValue(item);
                    if (value != null) return value.ToString() ?? "";
                }

                return "";
            }

            var id = ReadProp("Id", "RunId");
            var topic = ReadProp("Title", "Topic", "Structure", "DataStructure", "Algorithm");
            var input = ReadProp("InputSequence", "Input", "TestInput", "Arguments");
            var createdAt = ReadProp("CreatedAtUtc", "CreatedAt", "Timestamp", "SavedAt");
            var traceJson = ReadProp("TraceFramesJson", "TraceFrames");

            var language = "";
            var output = "Saved execution trace";
            var code = "";

            // The /Sandbox/Save endpoint stores these values in the JSONB column.
            // Older SaveTrace records may contain only a JSON array, so they safely
            // fall back to the defaults above.
            if (!string.IsNullOrWhiteSpace(traceJson))
            {
                try
                {
                    using var document = JsonDocument.Parse(traceJson);
                    var root = document.RootElement;

                    if (root.ValueKind == JsonValueKind.Object)
                    {
                        if (root.TryGetProperty("language", out var languageElement))
                            language = languageElement.ToString();

                        if (root.TryGetProperty("executionSummary", out var summaryElement))
                            output = summaryElement.ToString();
                        else if (root.TryGetProperty("output", out var outputElement))
                            output = outputElement.ToString();

                        if (root.TryGetProperty("sourceCode", out var sourceElement))
                            code = sourceElement.ToString();
                        else if (root.TryGetProperty("code", out var codeElement))
                            code = codeElement.ToString();
                    }
                }
                catch (JsonException)
                {
                    // Keep the row visible even if an older trace has invalid JSON.
                }
            }

            existingRuns.Add(new Dictionary<string, string>
            {
                ["Id"] = id,
                ["Topic"] = string.IsNullOrWhiteSpace(topic) ? "Custom Trace" : topic,
                ["Language"] = language,
                ["Input"] = input,
                ["Output"] = string.IsNullOrWhiteSpace(output) ? "Saved execution trace" : output,
                ["Code"] = code,
                ["CreatedAt"] = createdAt
            });
        }
    }
}

